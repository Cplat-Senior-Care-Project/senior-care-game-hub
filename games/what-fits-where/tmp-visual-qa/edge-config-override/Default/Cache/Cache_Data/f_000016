<!doctype html>
<html lang="ko">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="screen-orientation" content="landscape" />
  <title>오늘의 준비물</title>
  <script>
    (function () {
      var stageWidth = 1280;
      var stageHeight = 720;
      window.__updateStageScale = function () {
        var viewport = window.visualViewport;
        var width = viewport ? viewport.width : window.innerWidth;
        var height = viewport ? viewport.height : window.innerHeight;
        var scale = Math.min(width / stageWidth, height / stageHeight);
        var safeScale = Math.max(0.1, scale);
        document.documentElement.style.setProperty("--stage-scale", safeScale.toFixed(4));
        document.documentElement.style.setProperty("--viewport-unscaled-width", (width / safeScale).toFixed(2) + "px");
        document.documentElement.style.setProperty("--viewport-unscaled-height", (height / safeScale).toFixed(2) + "px");
      };
      window.__updateStageScale();
    }());
  </script>
  <link rel="stylesheet" href="css/styles.css" />
</head>

<body>
  <div id="stage-viewport">
    <div id="app">
      <!-- START -->
      <!-- CONDITION CHECK -->
      <div id="condition-modal" class="modal-layer is-hidden" role="dialog" aria-modal="true"
        aria-labelledby="condition-title">
        <div class="modal-card condition-card">
          <h2 id="condition-title" class="condition-title">
            <span class="condition-title-icon" aria-hidden="true">📝</span>
            <span class="condition-title-text">오늘 컨디션 체크</span>
            <span class="condition-title-icon" aria-hidden="true">✅</span>
          </h2>
          <div class="condition-layout">
            <section class="condition-panel condition-mood-panel" aria-labelledby="condition-mood-title">
              <h3 id="condition-mood-title" class="condition-section-title">오늘의 기분</h3>
              <div class="condition-mood-options" role="group" aria-label="condition mood">
                <button class="condition-mood-button is-selected" type="button" data-mood="good" aria-pressed="true">
                  <span class="condition-mood-face" aria-hidden="true">😆</span>
                  <span>좋음</span>
                </button>
                <button class="condition-mood-button" type="button" data-mood="normal" aria-pressed="false">
                  <span class="condition-mood-face" aria-hidden="true">😐</span>
                  <span>보통</span>
                </button>
                <button class="condition-mood-button" type="button" data-mood="bad" aria-pressed="false">
                  <span class="condition-mood-face" aria-hidden="true">😡</span>
                  <span>나쁨</span>
                </button>
              </div>
            </section>
            <section class="condition-panel condition-sleep-panel" aria-labelledby="condition-sleep-title">
              <h3 id="condition-sleep-title" class="condition-section-title">수면 시간</h3>
              <div class="condition-sleep-control">
                <div class="condition-sleep-dial" aria-live="polite">
                  <div id="condition-sleep-rows" class="condition-sleep-rows"></div>
                </div>
                <div class="condition-sleep-arrows">
                  <button id="condition-sleep-up-button" class="condition-sleep-arrow" type="button"
                    aria-label="sleep time up">▲</button>
                  <button id="condition-sleep-down-button" class="condition-sleep-arrow" type="button"
                    aria-label="sleep time down">▼</button>
                </div>
              </div>
            </section>
          </div>
          <div class="condition-actions">
            <button id="condition-skip-button" class="game-button condition-skip-button" type="button">건너뛰기</button>
            <button id="condition-confirm-button" class="game-button condition-confirm-button" type="button">확인</button>
          </div>
        </div>
      </div>

      <section class="screen active start-screen is-loading" id="screen-start">
        <button class="settings-gear" id="btn-settings" type="button" aria-label="설정" title="설정">⚙️</button>
        <div class="center-wrap">
          <img class="title-logo" src="assets/title-logo-home.png" alt="오늘의 준비물 - 상황에 맞는 물건을 천천히 골라보세요" />
          <p class="start-loading-message">게임을 준비하고 있어요</p>
          <div class="activity-label">일상생활 판단 활동</div>
          <div id="start-loading" class="start-loading" role="status" aria-live="polite" aria-label="로딩 중">
            <div class="start-loading-track" aria-hidden="true">
              <span id="start-loading-fill" class="start-loading-fill"></span>
            </div>
            <span id="start-loading-text" class="start-loading-text">0%</span>
          </div>
          <div id="mode-row" style="display:none"></div>
          <div id="diff-row" style="display:none"></div>
          <p id="diff-source" style="display:none"></p>
          <div class="start-actions">
            <div class="side left">
              <button class="btn-secondary" id="btn-howto">게임 방법</button>
              <button class="btn-secondary start-settings-button" id="btn-start-settings" type="button">설정하기</button>
            </div>
            <div class="side"><button class="btn-big" id="btn-start">게임 시작</button></div>
            <div class="side right hub-return"><button class="btn-secondary" id="btn-hub-return" type="button">게임
                종료</button></div>
          </div>
        </div>
      </section>

      <!-- DIFFICULTY SELECT -->
      <section class="screen difficulty-screen" id="screen-difficulty" aria-labelledby="difficulty-title">
        <div class="difficulty-content">
          <p class="eyebrow">난이도를 골라주세요</p>
          <h2 id="difficulty-title">어떤 문제로 시작할까요?</h2>
          <div class="difficulty-options" role="group" aria-label="난이도 선택">
            <button class="game-button difficulty-option" type="button" data-difficulty-index="0" data-diff="easy">
              <span class="difficulty-option-icon" aria-hidden="true">🙂</span>
              <strong>쉬움</strong>
              <span>천천히 시작!</span>
            </button>
            <button class="game-button difficulty-option" type="button" data-difficulty-index="1" data-diff="normal">
              <span class="difficulty-option-icon" aria-hidden="true">😊</span>
              <strong>보통</strong>
              <span>차근차근 도전!</span>
            </button>
            <button class="game-button difficulty-option" type="button" data-difficulty-index="2" data-diff="hard">
              <span class="difficulty-option-icon" aria-hidden="true">🤩</span>
              <strong>어려움</strong>
              <span>집중해서 도전!</span>
            </button>
          </div>
          <button id="difficulty-back-button" class="game-button secondary-button difficulty-back-button"
            type="button">닫기</button>
        </div>
      </section>

      <!-- PLAY -->
      <section class="screen" id="screen-play">
        <div class="play">
          <div class="topbar">
            <div class="timer-wrap" id="p-timer-wrap" role="progressbar" aria-label="남은시간">
              <span class="timer" id="p-timer">남은 시간</span>
              <span class="timer-gauge" aria-hidden="true"><span id="p-timer-fill"></span></span>
            </div>
            <div class="activity-label play-label">일상생활 판단 활동</div>
            <div class="pills">
              <span class="pill" id="p-qnum">진행 단계 1/10</span>
            </div>
            <div class="actions">
              <button class="icon-btn hint-btn" id="btn-hint" type="button" title="힌트 보기">힌트</button>
              <button class="icon-btn" id="btn-pause" title="일시정지">⏸ 일시정지</button>
            </div>
          </div>

          <div class="qcard">
            <div class="sit" id="p-situation">상황 문장</div>
            <div class="target" id="p-target"></div>
          </div>

          <div id="p-seen" class="seen-row" style="display:none"></div>

          <div class="choices-wrap">
            <div class="fb-area" id="p-feedback-area">
              <div class="fb-msg" id="p-feedback"></div>
            </div>
            <div class="choices" id="p-choices"></div>
          </div>
        </div>
      </section>

      <!-- RESULT -->
      <section class="screen" id="screen-result">
        <div class="activity-label result-care-label" aria-hidden="true">일상생활 판단 활동</div>
        <div class="center-wrap">
          <div class="result-box result-final-card">
            <h1 class="result-title">오늘의 준비물</h1>
            <div class="result-divider" aria-hidden="true"></div>
            <div class="result-summary-panel" aria-label="활동 결과 요약">
              <div class="result-emblem" aria-hidden="true">🏆</div>
              <div class="result-copy">
                <p class="result-positive" id="r-msg">오늘도 끝까지 잘 해내셨어요.</p>
                <p class="result-note" id="r-note">천천히 판단하며 필요한 물건을 잘 찾아보셨어요.</p>
                <p class="result-detail" id="r-detail"></p>
              </div>
            </div>
            <div class="result-metrics" id="result-metrics" aria-label="결과 수치">
              <div class="result-metric">
                <span class="metric-label">정답 수 / 총 문제</span>
                <strong class="metric-value" id="result-correct-total">0 / 10</strong>
              </div>
              <div class="result-metric">
                <span class="metric-label">힌트 사용</span>
                <strong class="metric-value" id="result-hints">0회</strong>
              </div>
            </div>
            <div class="btns result-actions">
              <button class="ghost" id="btn-home" type="button">홈으로 돌아가기</button>
              <button class="btn-return" id="btn-return">효담콜로 돌아가기</button>
            </div>
          </div>
        </div>
      </section>

      <!-- SCORE -->
      <section class="screen" id="screen-score">
        <div class="activity-label">일상생활 판단 활동</div>
        <div class="center-wrap">
          <div class="result-box">
            <div class="hero">점수 확인</div>
            <div class="result-stats" aria-label="점수 결과">
              <div class="item">
                <span class="lbl">정답 문항 수</span>
                <span class="val" id="score-correct">0문항</span>
              </div>
              <div class="item">
                <span class="lbl">오답 문항 수</span>
                <span class="val" id="score-wrong">0문항</span>
              </div>
              <div class="item">
                <span class="lbl">정답률</span>
                <span class="val" id="score-accuracy">0%</span>
              </div>
            </div>
            <div class="btns">
              <button class="btn-return" id="btn-score-next">다음</button>
            </div>
          </div>
        </div>
      </section>

      <div id="post-condition-modal" class="modal-layer is-hidden" role="dialog" aria-modal="true"
        aria-labelledby="post-condition-title">
        <div class="modal-card condition-card post-condition-card">
          <h2 id="post-condition-title" class="condition-title post-condition-title">
            <span class="condition-title-icon" aria-hidden="true">📝</span>
            <span class="condition-title-text">마무리 체크</span>
            <span class="condition-title-icon" aria-hidden="true">✅</span>
          </h2>
          <div class="post-condition-progress" aria-hidden="true">
            <span class="post-condition-dot is-active"></span>
            <span class="post-condition-dot"></span>
          </div>
          <div class="post-condition-page" data-post-condition-page="0">
            <section class="post-condition-question" aria-labelledby="post-condition-mood-title">
              <h3 id="post-condition-mood-title" class="post-condition-question-title">
                <span>1</span>
                지금 기분은 어떠세요?
              </h3>
              <div class="post-condition-options" role="group" aria-label="game after mood">
                <button class="post-condition-option" type="button" data-post-field="moodAfter"
                  data-post-value="good" aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">😊</span>
                  <span>좋아요</span>
                </button>
                <button class="post-condition-option" type="button" data-post-field="moodAfter" data-post-value="normal"
                  aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">😐</span>
                  <span>보통이에요</span>
                </button>
                <button class="post-condition-option" type="button" data-post-field="moodAfter" data-post-value="hard"
                  aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">😔</span>
                  <span>안 좋아요</span>
                </button>
              </div>
            </section>
            <section class="post-condition-question" aria-labelledby="post-condition-fatigue-title">
              <h3 id="post-condition-fatigue-title" class="post-condition-question-title">
                <span>2</span>
                피로감은 어느 정도인가요?
              </h3>
              <div class="post-condition-options" role="group" aria-label="game after fatigue">
                <button class="post-condition-option" type="button" data-post-field="fatigue"
                  data-post-value="low" aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">🙂</span>
                  <span>괜찮아요</span>
                </button>
                <button class="post-condition-option" type="button" data-post-field="fatigue" data-post-value="medium"
                  aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">😓</span>
                  <span>조금 피곤해요</span>
                </button>
                <button class="post-condition-option" type="button" data-post-field="fatigue" data-post-value="high"
                  aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">😩</span>
                  <span>많이 피곤해요</span>
                </button>
              </div>
            </section>
            <div class="condition-actions post-condition-actions">
              <button id="post-condition-skip-button"
                class="game-button condition-skip-button post-condition-action-button" type="button">건너뛰기</button>
              <button id="post-condition-next-button"
                class="game-button condition-confirm-button post-condition-action-button" type="button">다음</button>
            </div>
          </div>
          <div class="post-condition-page" data-post-condition-page="1" hidden>
            <section class="post-condition-question" aria-labelledby="post-condition-difficulty-title">
              <h3 id="post-condition-difficulty-title" class="post-condition-question-title">
                <span>3</span>
                체감 난이도는 어땠나요?
              </h3>
              <div class="post-condition-options" role="group" aria-label="perceived difficulty">
                <button class="post-condition-option" type="button" data-post-field="perceivedDifficulty"
                  data-post-value="easy" aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">😄</span>
                  <span>쉬웠어요</span>
                </button>
                <button class="post-condition-option" type="button" data-post-field="perceivedDifficulty"
                  data-post-value="justRight" aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">🙂</span>
                  <span>적당했어요</span>
                </button>
                <button class="post-condition-option" type="button" data-post-field="perceivedDifficulty"
                  data-post-value="hard" aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">😰</span>
                  <span>어려웠어요</span>
                </button>
              </div>
            </section>
            <section class="post-condition-question" aria-labelledby="post-condition-help-title">
              <h3 id="post-condition-help-title" class="post-condition-question-title">
                <span>4</span>
                도움이 필요했나요?
              </h3>
              <div class="post-condition-options" role="group" aria-label="needed help">
                <button class="post-condition-option" type="button" data-post-field="neededHelp" data-post-value="some"
                  aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">✋</span>
                  <span>네</span>
                </button>
                <button class="post-condition-option" type="button" data-post-field="neededHelp"
                  data-post-value="none" aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">💪</span>
                  <span>아니요</span>
                </button>
              </div>
            </section>
            <section class="post-condition-question" aria-labelledby="post-condition-replay-title">
              <h3 id="post-condition-replay-title" class="post-condition-question-title">
                <span>5</span>
                다시 하고 싶나요?
              </h3>
              <div class="post-condition-options" role="group" aria-label="replay intent">
                <button class="post-condition-option" type="button" data-post-field="replayIntent"
                  data-post-value="yes" aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">⭐</span>
                  <span>네</span>
                </button>
                <button class="post-condition-option" type="button" data-post-field="replayIntent" data-post-value="no"
                  aria-pressed="false">
                  <span class="post-condition-face" aria-hidden="true">👋</span>
                  <span>아니요</span>
                </button>
              </div>
            </section>
            <div class="condition-actions post-condition-actions">
              <button id="post-condition-back-button" class="game-button secondary-button post-condition-action-button"
                type="button">이전</button>
              <button id="post-condition-confirm-button"
                class="game-button condition-confirm-button post-condition-action-button" type="button">확인</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Hint -->
    <div class="modal" id="hint-modal">
      <div class="box hint-box">
        <h3 id="hint-title">힌트</h3>
        <div class="hint-list" id="hint-list"></div>
        <div class="actions">
          <button class="keep" id="btn-hint-close" type="button">확인</button>
        </div>
      </div>
    </div>

    <!-- Pause menu -->
    <div id="pause-modal" class="modal-layer is-hidden" role="dialog" aria-modal="true" aria-labelledby="pause-title">
      <div class="modal-card pause-card">
        <h2 id="pause-title">잠시 쉬어가요</h2>
        <p>준비되면 이어서 해볼까요?</p>
        <div class="pause-layout">
          <div class="pause-action-panel">
            <button id="resume-button" class="game-button primary-button pause-main-button" type="button">계속하기</button>
            <div class="pause-small-actions">
              <button id="pause-restart-button" class="game-button secondary-button pause-sub-button"
                type="button">다시하기</button>
              <button id="home-button" class="game-button secondary-button pause-sub-button" type="button">그만하기</button>
            </div>
            <button id="pause-help-button" class="game-button secondary-button pause-help-button" type="button">
              <span class="pause-help-icon" aria-hidden="true">?</span>
              <span>진행방법</span>
            </button>
          </div>
          <section class="pause-sound-panel" aria-label="소리 설정">
            <div class="pause-sound-options">
              <button id="pause-background-sound-button" class="pause-sound-button" type="button" data-sound="bgm"
                aria-pressed="true">
                <span class="pause-sound-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M9 18V5l12-2v13"></path>
                    <circle cx="6" cy="18" r="3"></circle>
                    <circle cx="18" cy="16" r="3"></circle>
                  </svg>
                </span>
                <span class="pause-sound-name">배경음</span>
                <span class="pause-toggle-visual" aria-hidden="true"><span>ON</span><i></i></span>
              </button>
              <button id="pause-sound-button" class="pause-sound-button" type="button" data-sound="sfx"
                aria-pressed="true">
                <span class="pause-sound-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                  </svg>
                </span>
                <span class="pause-sound-name">효과음</span>
                <span class="pause-toggle-visual" aria-hidden="true"><span>ON</span><i></i></span>
              </button>
              <button id="pause-voice-guide-button" class="pause-sound-button" type="button" data-sound="voice"
                aria-pressed="true">
                <span class="pause-sound-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                  </svg>
                </span>
                <span class="pause-sound-name">안내음성</span>
                <span class="pause-toggle-visual" aria-hidden="true"><span>ON</span><i></i></span>
              </button>
            </div>
          </section>
        </div>
      </div>
    </div>

    <!-- Exit confirm -->
    <div class="modal" id="exit-modal">
      <div class="box">
        <h3>게임을 그만할까요?</h3>
        <p>지금까지 참여한 내용은 저장됩니다.<br>다음에 다시 새로운 게임으로 시작할 수 있어요.</p>
        <div class="actions">
          <button class="keep" id="btn-keep">계속하기</button>
          <button class="end" id="btn-end">그만하기</button>
        </div>
      </div>
    </div>

    <!-- Help / Tutorial (multi-page) -->
    <div class="modal" id="help-modal">
      <div class="box help-box">
        <img class="title-logo xs" src="assets/title-logo.png" alt="오늘의 준비물" />
        <h3>게임 방법</h3>
        <div class="help-body">
          <div class="htitle" id="help-title"></div>
          <p class="htext" id="help-text"></p>
        </div>
        <div class="help-progress" id="help-progress"></div>
        <div class="help-nav">
          <button id="help-prev">이전</button>
          <button id="help-next" class="primary-nav">다음</button>
          <button id="help-done" class="primary-nav" style="display:none">게임으로 돌아가기</button>
        </div>
      </div>
    </div>

    <!-- Settings -->
    <div id="settings-modal" class="modal-layer is-hidden" role="dialog" aria-modal="true"
      aria-labelledby="settings-title">
      <div class="modal-card settings-card">
        <div class="settings-layout">
          <section class="settings-sound-panel" aria-labelledby="settings-title">
            <h2 id="settings-title" class="settings-panel-title">
              <span class="settings-title-icon settings-title-icon-sound" aria-hidden="true">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M9 18V5l12-2v13"></path>
                  <circle cx="6" cy="18" r="3"></circle>
                  <circle cx="18" cy="16" r="3"></circle>
                </svg>
              </span>
              <span>소리 설정</span>
            </h2>
            <div class="settings-options">
              <label class="setting-row">
                <span class="setting-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M9 18V5l12-2v13"></path>
                    <circle cx="6" cy="18" r="3"></circle>
                    <circle cx="18" cy="16" r="3"></circle>
                  </svg>
                </span>
                <span class="setting-copy">
                  <strong id="background-sound-label">배경음 켬</strong>
                </span>
                <input id="background-sound-toggle" class="setting-toggle" type="checkbox" data-sound="bgm" checked>
              </label>
              <label class="setting-row">
                <span class="setting-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                  </svg>
                </span>
                <span class="setting-copy">
                  <strong id="sound-label">효과음 켬</strong>
                </span>
                <input id="sound-toggle" class="setting-toggle" type="checkbox" data-sound="sfx" checked>
              </label>
              <label class="setting-row">
                <span class="setting-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                  </svg>
                </span>
                <span class="setting-copy">
                  <strong id="voice-guide-label">안내음성 켬</strong>
                </span>
                <input id="voice-guide-toggle" class="setting-toggle" type="checkbox" data-sound="voice" checked>
              </label>
            </div>
          </section>
        </div>
        <div class="modal-actions settings-close-actions">
          <button id="settings-close-button" class="game-button secondary-button difficulty-back-button"
            type="button">닫기</button>
        </div>
      </div>
    </div>

    <!-- Countdown -->
    <div class="modal" id="countdown-modal">
      <div class="box countdown-box">
        <h3>곧 시작합니다!</h3>
        <p class="sub">잠시만 기다려주세요.</p>
        <div class="countdown-circle" id="countdown-num">3</div>
      </div>
    </div>

    <!-- Error -->
    <div class="modal" id="error-modal">
      <div class="box error-box">
        <div class="icon">⚠️</div>
        <h3>게임을 불러오는 중 문제가 생겼어요</h3>
        <p id="error-msg">잠시 후 다시 시도해주세요.</p>
        <div class="actions">
          <button class="keep" id="btn-error-retry">다시 시도</button>
          <button class="end" id="btn-error-exit">게임 나가기</button>
        </div>
      </div>
    </div>

    <!-- Loading -->
    <div id="loading-screen">
      <div class="activity-label loading-label">일상생활 판단 활동</div>
      <div class="loading-panel" aria-live="polite">
        <img class="title-logo sm" src="assets/title-logo.png" alt="오늘의 준비물" />
        <div class="loading-title">게임을 준비 중이에요</div>
        <div class="loading-sub">잠시만 기다려주세요!</div>
        <div class="loading-percent" id="loading-percent">0%</div>
        <div class="loading-bar">
          <div id="loading-bar-fill"></div>
        </div>
      </div>
    </div>

    <!-- Reveal correct answer -->
    <div class="modal" id="reveal-modal">
      <div class="box">
        <h3>정답을 함께 확인해볼게요</h3>
        <div id="reveal-content"></div>
        <p id="reveal-explain"></p>
      </div>
    </div>

  </div>
  <script src="config/modes.js"></script>
  <script src="js/items.js"></script>
  <script src="js/questions.js"></script>
  <script src="js/situation-templates.js"></script>
  <script src="js/audio.js"></script>
  <script src="modes/registry.js"></script>
  <script src="js/game.js"></script>
</body>

</html>
