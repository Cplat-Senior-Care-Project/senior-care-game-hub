  max-inline-size: none;
  block-size: clamp(58px, 7.5cqh, 70px);
  min-block-size: clamp(58px, 7.5cqh, 70px);
  padding: 0 clamp(14px, 1.6cqw, 22px);
  font-size: clamp(30px, 4.1cqh, 38px);
  line-height: 1.04;
}

@container stage (orientation:portrait) and (max-width:760px) {
  .post-check.screen {
    padding: 5px 8px calc(6px + env(safe-area-inset-bottom));
    gap: 4px;
  }

  .post-check .center-wrap {
    padding: 0;
  }

  .post-check .post-check-box {
    width: min(100%, calc(100cqw - 18px));
    max-height: calc(100cqh - 48px);
    padding: clamp(7px, 1.8cqw, 10px);
    gap: clamp(4px, 1.1cqw, 6px);
  }

  .post-title {
    font-size: clamp(25px, 6.2cqw, 31px);
    line-height: 1.04;
  }

  .post-label {
    font-size: clamp(20px, 4.9cqw, 24px);
    line-height: 1.05;
  }

  .post-options {
    gap: 5px;
  }

  .post-options button,
  .post-options[data-post-group="mood"] button,
  .post-options.two button {
    block-size: clamp(40px, 10cqw, 48px);
    min-block-size: clamp(40px, 10cqw, 48px);
    padding: 0 4px;
    font-size: clamp(16px, 4.4cqw, 21px);
    line-height: 1.02;
  }

  .post-actions {
    gap: 8px;
    margin-top: 2px;
  }

  .post-actions .btn-return,
  .post-actions .ghost {
    flex: 0 1 clamp(110px, 32cqw, 150px);
    block-size: clamp(44px, 10.7cqw, 52px);
    min-block-size: clamp(44px, 10.7cqw, 52px);
    padding: 0 8px;
    font-size: clamp(18px, 4.8cqw, 24px);
  }
}

#screen-difficulty.difficulty-screen {
  position: relative;
  background: transparent !important;
}

#screen-difficulty .difficulty-content,
#screen-difficulty .center-wrap::before,
#screen-difficulty .difficulty-panel {
  background: transparent !important;
}

#screen-difficulty.difficulty-screen::before {
  content: "";
  position: absolute;
  left: 5%;
  right: 5%;
  top: clamp(108px, 14cqh, 150px);
  bottom: clamp(112px, 15cqh, 148px);
  z-index: 0;
  border-radius: 0;
  background: rgba(255, 248, 226, .72);
  pointer-events: none;
}

#screen-difficulty .difficulty-content {
  position: relative;
  z-index: 1;
  min-height: 0 !important;
  max-height: calc(100cqh - 150px) !important;
}

#screen-difficulty.difficulty-screen::before,
#screen-difficulty .center-wrap::before {
  content: none !important;
  display: none !important;
}

#screen-difficulty .difficulty-content,
#screen-difficulty .difficulty-panel {
  background: #fffdf4 !important;
  background-image: none !important;
  border: 3px solid #d8bd82 !important;
  border-radius: 24px !important;
  box-shadow: 0 16px 34px rgba(84, 61, 28, .14), inset 0 1px 0 rgba(255, 255, 255, .95) !important;
}

body[data-screen="screen-difficulty"] #stage-viewport::before,
body[data-screen="screen-difficulty"] #stage-viewport::after,
body[data-screen="screen-difficulty"] #app::before,
body[data-screen="screen-difficulty"] #app::after,
body[data-screen="screen-difficulty"] #screen-difficulty::before,
body[data-screen="screen-difficulty"] #screen-difficulty::after {
  content: none !important;
  display: none !important;
  background: none !important;
  background-image: none !important;
  opacity: 0 !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

#screen-difficulty .difficulty-content {
  width: min(1160px, calc(100cqw - 88px)) !important;
  max-height: calc(100cqh - 116px) !important;
  padding: clamp(34px, 4.6cqh, 50px) clamp(34px, 4.4cqw, 54px) clamp(28px, 4cqh, 42px) !important;
  gap: clamp(16px, 2.2cqh, 22px) !important;
}

#screen-play .topbar {
  display: grid !important;
  grid-template-columns: minmax(190px, auto) minmax(0, 1fr) auto auto !important;
  grid-template-areas: "timer label pills actions" !important;
  align-items: center;
  gap: clamp(6px, 1cqw, 12px);
}

#screen-play .timer-wrap {
  --timer-gauge-height: clamp(18px, 3cqh, 28px);
  grid-area: timer;
  justify-self: start;
  display: flex;
  align-items: center;
  gap: 10px;
  width: clamp(235px, 24cqw, 320px);
  min-height: clamp(34px, 5cqh, 46px);
  padding: 5px 14px;
  border: 2px solid #d6b76c;
  border-radius: 999px;
  background: #fff4ce;
  box-shadow: 0 3px 0 rgba(199, 158, 70, .65), inset 0 1px 0 rgba(255, 255, 255, .9);
  min-width: 0;
  overflow: visible;
}

#screen-play .timer {
  display: inline-flex !important;
  align-items: center;
  flex: 0 0 auto;
  padding: 0 2px 0 4px;
  width: auto;
  height: var(--timer-gauge-height);
  min-height: var(--timer-gauge-height);
  min-width: 92px;
  border: 0;
  background: transparent;
  box-shadow: none;
  color: #5f3f12;
  font-size: clamp(17px, 2.45cqh, 22px);
  font-weight: 1000;
  line-height: 1;
  white-space: nowrap;
  overflow: visible;
  text-align: left;
}

#screen-play .timer-gauge {
  display: block;
  flex: 1 1 auto;
  min-width: 46px;
  height: var(--timer-gauge-height);
  overflow: hidden;
  border-radius: 999px;
  background: #fff8e6;
  box-shadow: inset 0 2px 5px rgba(98, 68, 18, .18);
}

#screen-play .timer-gauge span {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: inherit;
  background: #78a83b;
  transition: width .3s linear;
}

#screen-play .play-label {
  grid-area: label !important;
}

#screen-play .topbar .pills {
  grid-area: pills !important;
}

#screen-play .topbar .actions {
  grid-area: actions !important;
  justify-self: end;
}

#hint-modal.active {
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

#exit-modal .box h3 {
  white-space: nowrap;
  font-size: clamp(44px, 6.2cqh, 56px);
  line-height: 1.08;
}

@container stage (max-width:760px), stage (max-height:560px) {
  #screen-play .topbar {
    grid-template-columns: minmax(138px, auto) minmax(0, 1fr) auto !important;
    grid-template-areas:
      "timer label actions"
      "timer pills actions" !important;
  }

  #screen-play .timer-wrap {
    --timer-gauge-height: clamp(14px, 4cqw, 22px);
    width: clamp(188px, 41cqw, 240px);
    min-height: clamp(26px, 7cqw, 36px);
    padding: 4px 10px;
    gap: 6px;
  }

  #screen-play .timer {
    display: inline-flex !important;
    min-width: 70px;
    min-height: var(--timer-gauge-height);
    padding: 0 1px 0 3px;
    font-size: clamp(13px, 3.2cqw, 17px);
  }

  #screen-play .timer-gauge {
    height: var(--timer-gauge-height);
  }

  #exit-modal .box h3 {
    font-size: clamp(34px, 8cqw, 44px);
  }
}
