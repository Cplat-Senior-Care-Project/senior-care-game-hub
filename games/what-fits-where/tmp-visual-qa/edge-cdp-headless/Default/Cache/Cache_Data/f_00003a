  border: 3px solid #D9CFB3;
  background: #FFFDF8;
  color: #1F2433;
  font-size: clamp(38px, 5.2cqh, 48px);
  font-weight: 900;
  line-height: 1.2;
  transition: background .15s, border-color .15s, box-shadow .15s, transform .1s
}

.post-options button:hover {
  background: #FFF4DA;
  border-color: #B48A2E
}

.post-options button:active {
  transform: translateY(2px)
}

.post-options button.sel {
  background: #E6EEFB;
  border-color: #1E5BBF;
  color: #0E1322;
  box-shadow: 0 0 0 3px rgba(30, 91, 191, .18)
}

.post-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
  margin-top: 4px
}

.post-actions button {
  flex: 1;
  min-height: 56px
}

.post-actions .btn-return {
  padding: clamp(15px, 2.3cqh, 20px) clamp(24px, 3.4cqw, 38px);
  border-radius: 14px;
  background: linear-gradient(135deg, #1E5BBF, #3D86E8);
  color: #FFFFFF;
  font-weight: 900;
  font-size: clamp(38px, 5cqh, 46px);
  border: 3px solid #154A9E;
  box-shadow: 0 6px 16px -6px rgba(30, 91, 191, .5)
}

.post-actions .btn-return:disabled {
  opacity: .45;
  cursor: not-allowed;
  filter: grayscale(.25);
  box-shadow: none
}

.post-actions .ghost {
  font-size: clamp(36px, 4.8cqh, 44px);
  font-weight: 900
}

@container stage (max-width:520px) {
  .result-stats {
    grid-template-columns: repeat(3, 1fr);
    padding: 12px 6px
  }

  .result-box .btns {
    flex-direction: column-reverse;
    align-items: stretch
  }

  .result-box .btn-return,
  .result-box .ghost {
    width: 100%;
    min-width: 0
  }

  .post-check .center-wrap {
    justify-content: flex-start
  }

  .post-check-box {
    padding: 16px;
    gap: 12px
  }

  .post-options,
  .post-options.two {
    grid-template-columns: 1fr
  }

  .post-actions {
    flex-direction: column-reverse
  }
}

/* Landscape phone */
@container stage (orientation:landscape) and (max-height:520px) {
  .screen {
    padding: 6px 10px;
    gap: 5px
  }

  .title {
    font-size: clamp(36px, 9.6cqh, 48px)
  }

  .subtitle {
    font-size: clamp(26px, 5.6cqh, 32px);
    line-height: 1.3
  }

  #screen-difficulty::before {
    inset: 8px;
    border-radius: 18px
  }

  #screen-difficulty .center-wrap {
    gap: 6px;
    padding: 4px 0
  }

  #screen-difficulty .title {
    font-size: clamp(40px, 14cqh, 56px)
  }

  #screen-difficulty .title::before {
    width: 54px;
    height: 5px;
    margin-bottom: 6px
  }

  #screen-difficulty .subtitle {
    font-size: clamp(24px, 6.2cqh, 30px)
  }

  #screen-difficulty .diff-row {
    gap: 8px;
    width: min(100%, 900px)
  }

  #screen-difficulty .opt-card {
    min-height: 82px;
    padding: 12px 10px 10px 62px;
    border-radius: 16px
  }

  #screen-difficulty .opt-card::after {
    height: 6px
  }

  #screen-difficulty .opt-card::before {
    left: 12px;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    font-size: 40px;
    border-width: 2px
  }

  #screen-difficulty .opt-card .name {
    font-size: clamp(32px, 8.8cqh, 44px)
  }

  #screen-difficulty .opt-card .desc {
    font-size: clamp(22px, 5.6cqh, 26px)
  }

  #screen-difficulty #btn-diff-back {
    margin-top: 4px;
    min-width: 150px
  }

  .opt-card {
    padding: 6px 10px
  }

  .opt-card .name {
    font-size: clamp(30px, 6.8cqh, 36px)
  }

  .opt-card .desc {
    font-size: clamp(24px, 5.2cqh, 30px)
  }

  .primary {
    padding: 9px 18px;
    font-size: 32px
  }

  .play {
    grid-template-rows: auto auto minmax(0, clamp(30px, 4.4cqh, 44px)) minmax(0, 1fr);
    gap: 5px
  }

  .qcard {
    padding: 6px 10px
  }

  .qcard .sit {
    font-size: clamp(34px, 8.2cqh, 46px);
    font-weight: 900;
    line-height: 1.26
  }

  .qcard .target {
    font-size: 30px;
    padding: 4px 10px
  }

  .fb-area {
    min-height: 34px;
    max-height: 42px
  }

  .fb-msg {
    font-size: 30px;
    padding: 5px 11px
  }

  .seen-row {
    padding: 4px;
    gap: 8px
  }

  .seen-item {
    padding: 6px;
    gap: 3px;
    border-width: 2px;
    border-radius: 12px
  }

  .seen-item .ph {
    width: clamp(60px, 16cqh, 110px);
    height: clamp(60px, 16cqh, 110px);
    padding: 5px
  }

  .seen-item .n {
    font-size: clamp(28px, 6cqh, 34px)
  }

  .choice {
    padding: 6px;
    gap: 4px;
    border-width: 3px;
    border-radius: 14px
  }

  .choice .ph {
    border-radius: 10px;
    padding: 4px
  }

  .choice .n {
    font-size: clamp(40px, 10cqh, 48px);
    line-height: 1.04
  }

  .choice.sit {
    padding: 8px 6px
  }

  .choice.sit .n {
    font-size: clamp(30px, 6.4cqh, 36px)
  }

  .pill {
    padding: 4px 9px;
    font-size: 28px
  }

  .timer {
    padding: 4px 10px;
    font-size: 30px
  }

  .icon-btn {
    padding: 5px 10px;
    font-size: 30px
  }
}

/* Portrait phone */
@container stage (orientation:portrait) and (max-width:760px) {
  .card-row {
    grid-template-columns: 1fr;
    gap: 6px
  }

  .diff-row {
    grid-template-columns: repeat(3, 1fr);
    gap: 6px
  }

  #screen-difficulty::before {
    inset: 10px;
    border-radius: 20px
  }

  #screen-difficulty .center-wrap {
    justify-content: center;
    padding: 14px 8px;
    gap: 12px
  }

  #screen-difficulty .title {
    font-size: clamp(50px, 12cqw, 68px)
  }

  #screen-difficulty .subtitle {
    font-size: clamp(28px, 7.2cqw, 34px);
    padding: 0 12px
  }

  #screen-difficulty .diff-row {
    grid-template-columns: 1fr;
    gap: 12px;
    width: min(100%, 430px)
  }

  #screen-difficulty .opt-card {
    min-height: 104px;
    padding: 18px 18px 18px 88px;
    border-radius: 20px
  }

  #screen-difficulty .opt-card::before {
    left: 20px;
    width: 50px;
    height: 50px;
    border-radius: 16px;
    font-size: 50px
  }

  #screen-difficulty .opt-card .name {
    font-size: clamp(42px, 10cqw, 54px)
  }

  #screen-difficulty .opt-card .desc {
    font-size: clamp(26px, 6.8cqw, 32px)
  }

  .opt-card {
    padding: 8px 12px
  }

  .play {
    gap: 6px
  }

  .qcard {
    padding: 14px 16px
  }

  .qcard .sit {
    font-size: clamp(48px, 6.4cqh, 60px);
    font-weight: 900;
    line-height: 1.4
  }

  .choices.n4 {
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr)
  }

  .choices.n5,
  .choices.n6 {
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(3, 1fr)
  }

  .choices.n7,
  .choices.n8 {
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr)
  }

  .choice .n {
    font-size: clamp(40px, 5cqh, 48px)
  }
}

@container stage (orientation:portrait) and (max-width:430px) {
  .topbar .pill {
    padding: 4px 9px;
    font-size: 28px
  }

  .timer {
    font-size: 30px;
    padding: 4px 9px
  }

  .qcard .sit {
    font-size: 48px;
    font-weight: 900;
    line-height: 1.4
  }
}

/* ===== CONDITION CHECK ===== */
#screen-condition .cc-card {
  background: #FFFDF6;
  border: 2px solid #E8DDB5;
  border-radius: 28px;
  padding: clamp(16px, 2.6cqh, 28px) clamp(18px, 3cqw, 36px);
  box-shadow: 0 12px 30px rgba(60, 40, 10, .08);
  max-width: 980px;
  width: min(96cqw, 980px);
  margin: 0 auto
}

#screen-condition .cc-title {
  font-size: clamp(42px, 5.8cqw, 64px);
  font-weight: 900;
  color: #2E3A1F;
  text-align: center;
  line-height: 1.12;
  margin: 0 0 clamp(8px, 1.4cqh, 14px)
}

#screen-condition .cc-card>.subtitle {
  font-size: clamp(28px, 3.3cqw, 38px);
  line-height: 1.28;
  max-width: 850px;
  margin-left: auto !important;
  margin-right: auto !important;
  word-break: keep-all
}

#screen-condition .cc-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(14px, 2.4cqw, 28px)
}

#screen-condition .cc-panel {
  background: #FAF4DE;
  border: 2px solid #ECDFA8;
  border-radius: 22px;
  padding: clamp(14px, 2.2cqh, 22px)
}

#screen-condition .cc-panel-head {
  text-align: center
}

#screen-condition .cc-label {
  display: inline-block;
  background: #FFF;
  border: 2px solid #E2D38A;
  color: #3A4A1A;
  font-weight: 800;
  font-size: clamp(30px, 3.4cqw, 38px);
  line-height: 1.1;
  padding: 6px 18px;
  border-radius: 999px;
  margin-bottom: clamp(8px, 1.4cqh, 12px);
  max-width: 100%;
  word-break: keep-all
}

#screen-condition .mood-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px
}

#screen-condition .mood-btn {
  background: #FFFBEA;
  border: 3px solid #E8DDB5;
  border-radius: 18px;
  padding: 12px 6px;
  font-size: clamp(30px, 3.5cqw, 38px);
  line-height: 1.05;
  font-weight: 800;
  color: #2E3A1F;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 108px;
  transition: all .15s ease;
  position: relative;
  word-break: keep-all
}

#screen-condition .mood-btn .emoji {
  font-size: clamp(56px, 6.8cqw, 74px);
  line-height: 1
}

#screen-condition .mood-btn[data-mood="normal"] {
  background: #FFF6D1
}

#screen-condition .mood-btn[data-mood="bad"] {
  background: #FBE0DA
}

#screen-condition .mood-btn.sel {
  border-color: #4F8B3C;
  box-shadow: 0 0 0 3px rgba(79, 139, 60, .18);
  background: #F1F8E6
}

#screen-condition .mood-btn.sel::after {
  content: "✓";
  position: absolute;
  top: -10px;
  right: -10px;
  background: #4F8B3C;
  color: #FFF;
  font-size: 36px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900
}

#screen-condition .sleep-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px
}

#screen-condition .sleep-btn {
  background: #FFFBEA;
  border: 3px solid #E8DDB5;
  border-radius: 16px;
  padding: 14px 8px;
  font-size: clamp(30px, 3.8cqw, 38px);
  font-weight: 800;
  color: #2E3A1F;
  cursor: pointer;
  min-height: 60px;
  transition: all .15s ease
}

#screen-condition .sleep-btn.sel {
  border-color: #4F8B3C;
  background: #F1F8E6;
  color: #2A5A1A;
  box-shadow: 0 0 0 3px rgba(79, 139, 60, .18)
}

/* Sleep stepper (3-row picker with up/down buttons) */
#screen-condition .sleep-stepper {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: clamp(10px, 1.6cqw, 18px);
  align-items: stretch
}

#screen-condition .sleep-rows {
  display: grid;
  grid-template-rows: 1fr 1.35fr 1fr;
  gap: 8px;
  background: #FFFBEA;
  border: 2px solid #E8DDB5;
  border-radius: 18px;
  padding: 10px;
  min-height: clamp(178px, 28cqh, 220px)
}

#screen-condition .sleep-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  font-weight: 800;
  color: #7A6E48;
  font-size: clamp(28px, 3.4cqw, 34px);
  line-height: 1.05;
  background: transparent;
  word-break: keep-all
}

#screen-condition .sleep-cell.center {
  background: #F1F8E6;
  border: 3px solid #4F8B3C;
  color: #2A5A1A;
  font-size: clamp(46px, 5.4cqw, 60px);
  font-weight: 900;
  box-shadow: 0 0 0 3px rgba(79, 139, 60, .15)
}

#screen-condition .sleep-cell.empty {
  opacity: .0
}

#screen-condition .sleep-arrows {
  display: grid;
  grid-template-rows: 1fr 1fr;
  gap: 8px
}

#screen-condition .sleep-arrow {
  background: #FFFBEA;
  border: 3px solid #E8DDB5;
  border-radius: 16px;
  width: clamp(58px, 7.2cqw, 78px);
  font-size: clamp(50px, 5.9cqw, 64px);
  line-height: 1;
  font-weight: 900;
  color: #3A4A1A;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .12s ease
}

#screen-condition .sleep-arrow:hover:not(:disabled) {
  background: #F1F8E6;
  border-color: #4F8B3C
}

#screen-condition .sleep-arrow:active:not(:disabled) {
  transform: translateY(2px)
}

#screen-condition .sleep-arrow:disabled {
  opacity: .35;
  cursor: not-allowed
}

#screen-condition .cc-confirm-wrap {
  display: flex;
  justify-content: center;
  margin-top: clamp(14px, 2.4cqh, 22px)
}

#screen-condition.screen {
  gap: clamp(8px, 1.4cqh, 14px);
  padding-bottom: calc(clamp(10px, 1.7cqh, 20px) + env(safe-area-inset-bottom));
  overflow: hidden
}

#screen-condition .center-wrap {
  justify-content: center;
  overflow: auto;
  -webkit-overflow-scrolling: touch;
  padding: 0
}

#screen-condition .cc-confirm-bar {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  gap: 12px;
  width: min(100%, 900px);
  margin: 0 auto;
  padding: 0;
  box-sizing: border-box
}

#screen-condition .cc-skip {
  background: #FFFBEA;
  color: #3A4A1A;
  font-size: clamp(30px, 3.4cqw, 38px);
  line-height: 1.05;
  font-weight: 900;
  border: 3px solid #E8DDB5;
  border-radius: 18px;
  padding: 12px 20px;
  cursor: pointer;
  min-height: 60px;
  min-width: clamp(118px, 22cqw, 180px);
  box-shadow: 0 6px 0 #D8C98C;
  transition: transform .1s;
  white-space: nowrap
}

#screen-condition .cc-skip:active {
  transform: translateY(2px);
  box-shadow: 0 4px 0 #D8C98C
}

#screen-condition .cc-confirm {
  background: #6BAE45;
  color: #FFF;
  font-size: clamp(34px, 4cqw, 44px);
  line-height: 1.05;
  font-weight: 900;
  border: none;
  border-radius: 18px;
  padding: 12px 24px;
  cursor: pointer;
  width: 100%;
  max-width: 520px;
  min-height: 60px;
  display: block;
  box-shadow: 0 6px 0 #4F8B3C;
  transition: opacity .15s, transform .1s
}

#screen-condition .cc-confirm:disabled {
  opacity: .45;
  cursor: not-allowed;
  box-shadow: 0 4px 0 #B8B0A0
}

#screen-condition .cc-confirm:not(:disabled):active {
  transform: translateY(2px);
  box-shadow: 0 4px 0 #4F8B3C
}

@container stage (max-width:700px) and (orientation:portrait) {
  #screen-condition.screen {
    overflow: auto
  }

  #screen-condition .center-wrap {
    flex: 0 0 auto;
    min-height: auto;
    justify-content: flex-start;
    overflow: visible
  }

  #screen-condition .cc-card {
    width: 100%
  }

  #screen-condition .cc-confirm-bar {
    margin-top: 10px;
    margin-bottom: 4px
  }

  #screen-condition .cc-grid {
    grid-template-columns: 1fr
  }

  #screen-condition .cc-title {
    font-size: 44px
  }

  #screen-condition .mood-btn {
    min-height: 92px
  }

  #screen-condition .cc-confirm {
    min-width: 0;
    width: 100%;
    padding: 14px 24px;
    font-size: 40px
  }

  #screen-condition .cc-skip {
    min-width: 118px;
    padding: 12px 12px;
    font-size: 30px
  }

  #screen-condition .sleep-rows {
    min-height: 210px
  }

  #screen-condition .sleep-arrow {
    width: clamp(56px, 18cqw, 72px)
  }
}

@container stage (max-height:680px) {
  #screen-condition .cc-card {
    padding: 12px 14px
  }

  #screen-condition .cc-title {
    font-size: 40px;
    margin-bottom: 6px
  }

  #screen-condition .cc-grid {
    gap: 10px
  }

  #screen-condition .cc-panel {
    padding: 10px
  }

  #screen-condition .cc-label {
    font-size: 30px;
    margin-bottom: 6px;
    padding: 4px 12px
  }

  #screen-condition .mood-btn {
    min-height: 78px;
    padding: 8px 4px
  }

  #screen-condition .mood-btn .emoji {
    font-size: 48px
  }

  #screen-condition .sleep-rows {
    min-height: 160px
  }

  #screen-condition.screen {
    padding-bottom: calc(8px + env(safe-area-inset-bottom))
  }
}

@container stage (orientation:landscape) and (max-height:520px) {
  #screen-condition .center-wrap {
    padding-top: 0
  }

  #screen-condition .cc-title {
    font-size: 36px;
    margin-bottom: 4px
  }

  #screen-condition .cc-card>.subtitle {
    display: none
  }

  #screen-condition .mood-btn {
    min-height: 64px
  }

  #screen-condition .sleep-rows {
    min-height: 120px
  }

  #screen-condition .cc-confirm {
    min-height: 48px;
    padding: 10px 20px;
    font-size: 34px
  }

  #screen-condition .cc-skip {
    min-height: 48px;
    min-width: 100px;
    padding: 10px 12px;
    font-size: 30px
  }

  #screen-condition .cc-confirm-bar {
    gap: 8px;
    padding: 0
  }

  #screen-condition.screen {
    padding-bottom: calc(6px + env(safe-area-inset-bottom))
  }
}

/* ===== COZY PLAYFUL THEME ===== */
:root {
  --cream: #FFF9EC;
  --cream-2: #F9F1DE;
  --paper: #FFFDF8;
  --ink: #11172A;
  --line: #D9C894;
  --line-strong: #BCA666;
  --honey: #F5C95F;
  --peach: #F5A58B;
  --mint: #A6D8B6;
  --sky: #9DC4F3;
  --berry: #D67A92;
  --shadow: 0 12px 0 rgba(188, 166, 102, .32), 0 18px 30px rgba(57, 43, 15, .13);
  --soft-shadow: 0 8px 20px rgba(57, 43, 15, .11);
}

html,
body {
  color: var(--ink)
}

#app {
  background: transparent;
}

.screen {
  padding: clamp(10px, 1.7cqh, 20px) clamp(14px, 2.1cqw, 28px)
}

.pill,
.timer,
.icon-btn,
.btn-secondary,
.ghost,
.primary,
.btn-big {
  border-width: 2px;
  letter-spacing: 0;
}

.pill {
  background: #FFF2C2;
  border-color: #E4C869;
  color: #302815;
  box-shadow: 0 4px 0 rgba(201, 176, 97, .32);
}

.btn-big,
.primary,
.result-box .btn-return,
.post-actions .btn-return,
.modal .actions .keep {
  background: linear-gradient(180deg, #5C96E8 0%, #2F6FCB 100%);
  border-color: #225AAE;
  box-shadow: 0 6px 0 #1F4F96, 0 12px 20px rgba(47, 111, 203, .22);
}

.btn-big:hover,
.primary:hover,
.result-box .btn-return:hover,
.post-actions .btn-return:hover,
.modal .actions .keep:hover {
  filter: brightness(1.04);
  transform: translateY(-1px);
}

.btn-secondary,
.ghost,
.icon-btn {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF3D7 100%);
  border-color: #CDBB84;
  box-shadow: 0 5px 0 rgba(188, 166, 102, .35);
}

.btn-secondary:hover,
.ghost:hover,
.icon-btn:hover {
  background: #FFF0BD;
  border-color: #B8953F
}

#screen-start,
#screen-difficulty,
#screen-play,
#screen-result,
#screen-score,
.post-check {
  position: relative;
  overflow: hidden;
}

#screen-start::before,
#screen-difficulty::after,
#screen-play::before,
#screen-result::before,
#screen-score::before,
.post-check::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, .52) 0%, rgba(255, 255, 255, .18) 44%, rgba(230, 241, 234, .26) 100%);
  opacity: .74;
}

.center-wrap,
.play {
  position: relative;
  z-index: 1
}

.title-logo {
  filter: drop-shadow(0 10px 0 rgba(188, 166, 102, .18)) drop-shadow(0 18px 24px rgba(57, 43, 15, .1));
}

.start-actions {
  background: rgba(255, 253, 248, .74);
  border: 2px solid rgba(217, 200, 148, .8);
  border-radius: 8px;
  padding: clamp(10px, 1.7cqh, 16px);
  box-shadow: var(--soft-shadow);
}

#screen-play.screen {
  padding: clamp(9px, 1.45cqh, 18px) clamp(14px, 2cqw, 28px)
}

.play {
  grid-template-rows: auto auto minmax(0, clamp(38px, 5cqh, 58px)) minmax(0, 1fr);
  gap: clamp(8px, 1.25cqh, 13px);
}

.topbar {
  background: rgba(255, 253, 248, .9);
  border: 2px solid rgba(217, 200, 148, .9);
  border-bottom-color: #C5B06F;
  border-radius: 8px;
  padding: clamp(6px, 1cqh, 10px);
  box-shadow: 0 7px 0 rgba(188, 166, 102, .26), 0 12px 20px rgba(57, 43, 15, .1);
}

.topbar .pills {
  gap: 8px
}

.topbar .pill {
  padding: clamp(5px, .9cqh, 8px) clamp(13px, 1.6cqw, 18px);
  border-radius: 999px;
  border-width: 2px;
  box-shadow: 0 4px 0 rgba(100, 84, 45, .16);
}

.topbar .pill:nth-child(1) {
  background: #FFE7DC;
  border-color: #E9A58D;
  color: #3A2117
}

.topbar .pill:nth-child(2) {
  background: #EAF8DD;
  border-color: #A6D47B;
  color: #203613
}

.topbar .pill:nth-child(3) {
  background: #E8F2FF;
  border-color: #93BDEF;
  color: #142D52
}

.topbar .pill:nth-child(4) {
  background: #FFF3BE;
  border-color: #E4C869;
  color: #3D2B02
}

.topbar .actions {
  gap: 9px
}

.hint-btn {
  background: linear-gradient(180deg, #FFF4B8 0%, #FFD86A 100%);
  border-color: #D7AD37;
  color: #4A3100;
}

.hint-btn.active,
.hint-btn[aria-pressed="true"] {
  filter: brightness(.96);
  box-shadow: inset 0 3px 0 rgba(129, 91, 10, .16), 0 3px 0 rgba(174, 134, 41, .22);
}

.timer {
  background: linear-gradient(180deg, #FFF6C9 0%, #FAD56C 100%);
  border: 2px solid #D7AD37;
  color: #4A3100;
  box-shadow: 0 5px 0 rgba(174, 134, 41, .28);
}

.qcard {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, .9) 0%, rgba(255, 249, 236, .96) 100%),
    linear-gradient(90deg, rgba(245, 165, 139, .2), rgba(166, 216, 182, .16));
  border: 3px solid #DCC78D;
  border-radius: 8px;
  padding: clamp(16px, 2.2cqh, 24px) clamp(20px, 2.6cqw, 34px) clamp(15px, 2cqh, 22px);
  box-shadow: 0 8px 0 rgba(188, 166, 102, .28), 0 14px 24px rgba(57, 43, 15, .09);
}

.qcard::before {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  width: clamp(8px, 1cqw, 14px);
  background: #D9C894;
}

.qcard::after {
  content: none;
}

.qcard .sit {
  color: #11172A;
  text-shadow: 0 2px 0 rgba(255, 255, 255, .9);
}

.qcard .target {
  display: block;
  width: fit-content;
  max-width: 100%;
  margin: 8px auto 0;
  background: linear-gradient(180deg, #EAF7FF 0%, #D8ECFF 100%);
  border: 2px solid #6EAAE9;
  color: #102848;
  box-shadow: 0 4px 0 rgba(109, 153, 206, .22);
  text-align: center;
}

.fb-area {
  min-height: clamp(46px, 5.8cqh, 62px)
}

.fb-msg {
  border-radius: 999px;
  border-width: 2px;
  box-shadow: 0 5px 0 rgba(68, 52, 18, .12);
}

.fb-msg.hint {
  background: #FFF4BE;
  border-color: #E5BE42;
  color: #4A3100
}

.fb-msg.ok {
  background: #DDF4E3;
  border-color: #62B87B;
  color: #154B28
}

.fb-msg.no {
  background: #FFE0DA;
  border-color: #DB7164;
  color: #792016
}

.choices {
  gap: clamp(12px, 1.35cqw, 18px)
}

.choice {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8EA 100%);
  border: 3px solid #CDBB84;
  border-radius: 8px;
  gap: clamp(5px, .8cqh, 8px);
  padding: clamp(9px, 1.2cqh, 14px);
  box-shadow: var(--shadow);
  transition: transform .16s ease, box-shadow .16s ease, background .16s ease, border-color .16s ease;
}

.choice::before {
  content: none;
}

.choice .ph {
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FFF9EF 100%);
  border: 2px dashed #E2CF96;
  border-radius: 8px;
  padding: clamp(3px, .55cqh, 7px);
}

.choice .ph img {
  filter: drop-shadow(0 10px 8px rgba(47, 35, 10, .16));
  transform: scale(1.14);
  transform-origin: center;
}

.choice .n {
  background: #FFFDF8;
  border: 2px solid #E6D49F;
  border-radius: 999px;
  padding: clamp(4px, .7cqh, 7px) clamp(12px, 1.2cqw, 18px);
  max-width: 100%;
  box-shadow: inset 0 -3px 0 rgba(245, 201, 95, .22);
}

.choice:hover {
  background: #FFF2C8;
  border-color: #B8953F;
  transform: translateY(-4px);
  box-shadow: 0 15px 0 rgba(188, 166, 102, .3), 0 24px 36px rgba(57, 43, 15, .14);
}

.choice:active {
  transform: translateY(1px);
  box-shadow: 0 7px 0 rgba(188, 166, 102, .32), 0 13px 20px rgba(57, 43, 15, .12)
}

.choice:focus-visible {
  outline: 4px solid rgba(47, 111, 203, .35);
  outline-offset: 3px
}

.choice.picked {
  background: linear-gradient(180deg, #F8FFF6 0%, #DFF3DC 100%);
  border-color: #5EAB62;
}

.choice.picked .n {
  border-color: #91CF8F;
  background: #F7FFF5
}

.choice.picked::after,
.choice.removed-state::after {
  top: 9px;
  right: 10px;
  width: 38px;
  height: 38px;
  border: 3px solid currentColor;
  font-size: 34px;
  box-shadow: 0 4px 0 rgba(57, 43, 15, .16);
}

.choice.removed-state {
  background: linear-gradient(180deg, #FFF6F4 0%, #FFDCD6 100%);
  border-color: #D9675E;
  opacity: .78;
}

.choice.removed-state .n {
  border-color: #EEAAA4;
  background: #FFF8F6
}

.choice.sit {
  background: linear-gradient(180deg, #FFFFFF 0%, #F0F7FF 100%);
  justify-content: center;
}

.choice.sit .n {
  border-radius: 8px;
  background: transparent;
  border: 0;
  box-shadow: none;
  padding: 0 clamp(8px, 1cqw, 12px);
}

.seen-item {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF1C4 100%);
  border: 3px solid #E0BC4A;
  border-radius: 8px;
  box-shadow: 0 8px 0 rgba(188, 166, 102, .3), 0 12px 20px rgba(57, 43, 15, .1);
}

.seen-item .ph {
  border: 2px dashed #DDBB56;
  border-radius: 8px;
  background: #FFFDF8;
}

.seen-item .ph img {
  filter: drop-shadow(0 8px 7px rgba(47, 35, 10, .14))
}

.seen-item .n {
  background: #FFFDF8;
  border: 2px solid #E6D49F;
  border-radius: 999px;
  padding: 3px 12px;
}

.modal {
  background: rgba(36, 32, 24, .42);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px)
}

.modal .box,
.result-box,
.post-check-box,
#screen-condition .cc-card {
  border: 3px solid #D9C894;
  border-radius: 8px;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8EA 100%);
  box-shadow: var(--shadow);
}

.help-body,
.sound-row,
.hint-line,
.result-stats,
#screen-condition .cc-panel,
#screen-condition .sleep-rows {
  border-radius: 8px;
  background: rgba(255, 253, 248, .82);
  border-color: #D9C894;
}

#reveal-modal .answer-item {
  border-radius: 8px;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF1C4 100%);
  border-color: #E0BC4A;
}

