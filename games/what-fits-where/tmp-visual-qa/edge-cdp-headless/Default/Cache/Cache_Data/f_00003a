/* Image button skin. Topbar game controls intentionally keep their current style. */
:root {
  --image-btn-pink: url("../assets/ui/button-pink.png");
  --image-btn-beige: url("../assets/ui/button-beige.png");
  --image-btn-primary-text: #73304A;
  --image-btn-secondary-text: #60482C;
}

.btn-big,
.primary,
.result-box .btn-return,
.post-actions .btn-return,
.help-nav button.primary-nav {
  background-color: transparent;
  background-image: var(--image-btn-pink);
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  border: 0;
  box-shadow: none;
  color: var(--image-btn-primary-text);
  text-shadow: 0 1px 0 rgba(255, 255, 255, .84);
}

.btn-secondary,
.ghost,
.help-nav button:not(.primary-nav),
.modal .actions .keep,
.pause-btn,
.pause-btn.resume,
.pause-btn.restart,
.pause-btn.help,
.pause-btn.exit,
#screen-condition .mood-btn,
#screen-condition .mood-btn[data-mood="normal"],
#screen-condition .mood-btn[data-mood="bad"],
#screen-condition .sleep-btn,
#screen-condition .sleep-arrow,
#screen-condition .cc-skip,
#screen-condition .cc-confirm,
.post-options button {
  background-color: transparent;
  background-image: var(--image-btn-beige);
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  border: 0;
  box-shadow: none;
  color: var(--image-btn-secondary-text);
  text-shadow: 0 1px 0 rgba(255, 255, 255, .76);
}

.btn-big:hover,
.primary:hover,
.result-box .btn-return:hover,
.post-actions .btn-return:hover,
.help-nav button.primary-nav:hover,
.btn-secondary:hover,
.ghost:hover,
.help-nav button:not(.primary-nav):hover,
.modal .actions .keep:hover,
.pause-btn:hover,
.pause-btn.resume:hover,
.pause-btn.restart:hover,
.pause-btn.help:hover,
.pause-btn.exit:hover,
#screen-condition .mood-btn:hover,
#screen-condition .sleep-btn:hover,
#screen-condition .sleep-arrow:hover:not(:disabled),
#screen-condition .cc-skip:hover,
#screen-condition .cc-confirm:hover:not(:disabled),
.post-options button:hover {
  background-color: transparent;
  border: 0;
  filter: brightness(1.025);
}

.btn-big:active,
.primary:active,
.result-box .btn-return:active,
.post-actions .btn-return:active,
.help-nav button:active,
.btn-secondary:active,
.ghost:active,
.modal .actions .keep:active,
.pause-btn:active,
#screen-condition .mood-btn:active,
#screen-condition .sleep-btn:active,
#screen-condition .sleep-arrow:active:not(:disabled),
#screen-condition .cc-skip:active,
#screen-condition .cc-confirm:not(:disabled):active,
.post-options button:active {
  transform: translateY(2px);
  box-shadow: none;
}

.btn-big:disabled,
.primary:disabled,
.result-box .btn-return:disabled,
.post-actions .btn-return:disabled,
.post-condition-action-button:disabled,
.help-nav button:disabled,
#screen-condition .cc-confirm:disabled {
  opacity: .46;
  filter: grayscale(.2);
  box-shadow: none;
}

#screen-condition .mood-btn.sel,
#screen-condition .sleep-btn.sel,
.post-options button.sel {
  background-color: transparent;
  background-image: var(--image-btn-beige);
  color: #28571E;
  outline: 4px solid #4F8B3C;
  outline-offset: -4px;
  box-shadow: none;
}

.post-options button {
  position: relative;
  overflow: hidden;
}

.post-options button.sel {
  background-color: #FFFDF8;
  background-image: none;
  border: 4px solid #4F8B3C;
  border-radius: 999px;
  color: #28571E;
  outline: 0;
  box-shadow: none;
  filter: none;
}

.post-options button.sel::after {
  content: none;
}

.pause-btn,
.pause-btn.resume,
.pause-btn.restart,
.pause-btn.help,
.pause-btn.exit {
  border-radius: 0;
  color: var(--image-btn-secondary-text);
}

