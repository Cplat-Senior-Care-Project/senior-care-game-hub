*,
*::before,
*::after {
  box-sizing: border-box
}

:root {
  --stage-width: 1280px;
  --stage-height: 720px;
  --stage-scale: 1
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  min-height: 100dvh;
  overflow: hidden;
  background: #FAF7F0;
  color: #1F2433;
  font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", sans-serif;
  -webkit-tap-highlight-color: transparent;
  line-height: 1.5;
  font-size: 36px
}

body {
  --viewport-bg-image: url("../assets/background-home.png");
  background-color: #FAF7F0;
  background-image: var(--viewport-bg-image);
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover
}

body[data-screen="screen-condition"],
body[data-screen="screen-difficulty"],
body[data-screen="screen-result"],
body[data-screen="screen-score"],
body[data-screen="screen-post-check-1"],
body[data-screen="screen-post-check-2"],
body[data-screen="loading-screen"] {
  --viewport-bg-image: url("../assets/background-pregame.png")
}

body[data-screen="screen-play"] {
  --viewport-bg-image: url("../assets/background-play.png")
}

button {
  font: inherit;
  color: inherit;
  cursor: pointer;
  border: none;
  background: none
}

img {
  display: block;
  max-width: 100%
}

#stage-viewport {
  position: fixed;
  left: 50%;
  top: 50%;
  z-index: 1;
  width: var(--stage-width);
  height: var(--stage-height);
  overflow: hidden;
  background: transparent;
  transform: translate(-50%, -50%) scale(var(--stage-scale));
  transform-origin: center center;
  container: stage / size
}

#app {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  background: transparent
}

.screen {
  flex: 1;
  min-height: 0;
  display: none;
  flex-direction: column;
  padding: clamp(8px, 1.6cqh, 18px) clamp(10px, 2cqw, 22px);
  gap: clamp(6px, 1.2cqh, 12px)
}

.screen.active {
  display: flex
}

h1,
h2,
h3 {
  margin: 0;
  font-weight: 800;
  color: #13182A;
  letter-spacing: 0
}

.muted {
  color: #4A5060
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 999px;
  background: #EEE6D2;
  font-size: 32px;
  color: #2A2F40;
  font-weight: 800;
  border: 1px solid #D9CFB3
}

/* START */
.center-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  gap: clamp(6px, 1.4cqh, 14px);
  width: 100%;
  overflow: hidden
}

#screen-result.active,
#screen-score.active {
  overflow: auto
}

#screen-result .center-wrap,
#screen-score .center-wrap {
  justify-content: center;
  overflow: visible
}

.title {
  font-size: clamp(48px, 7.6cqh, 76px);
  color: #13182A;
  line-height: 1.25
}

.subtitle {
  color: #3A4054;
  font-size: clamp(32px, 4cqh, 40px);
  max-width: 760px;
  line-height: 1.5;
  margin: 0
}

.title-logo {
  width: min(85cqw, 760px);
  height: auto;
  object-fit: contain;
  display: block;
  margin: 0 auto clamp(20px, 3.2cqh, 32px) auto;
  background: transparent
}

.title-logo.sm {
  width: min(72cqw, 420px);
  margin-bottom: clamp(12px, 2cqh, 20px)
}

.title-logo.xs {
  width: min(60cqw, 300px);
  margin-bottom: 8px
}

@container stage (max-width:480px) {
  .title-logo {
    width: 94cqw;
    margin-bottom: 24px
  }

  .title-logo.sm {
    width: 80cqw
  }
}

.card-row {
  display: grid;
  gap: clamp(6px, 1cqw, 12px);
  width: min(100%, 1000px);
  grid-template-columns: repeat(3, 1fr)
}

.opt-card {
  padding: clamp(8px, 1.6cqh, 16px) clamp(10px, 1.5cqw, 16px);
  border-radius: 14px;
  background: #FFFFFF;
  border: 2px solid #D9CFB3;
  text-align: left;
  transition: .15s;
  display: flex;
  flex-direction: column;
  gap: 4px;
  color: #1F2433;
  min-width: 0
}

.opt-card:hover {
  background: #FFF9EA;
  border-color: #B48A2E
}

.opt-card.active {
  border-color: #1E5BBF;
  background: #E6EEFB;
  box-shadow: 0 0 0 3px rgba(30, 91, 191, .18)
}

.opt-card .name {
  font-size: clamp(36px, 4.6cqh, 48px);
  font-weight: 800;
  color: #13182A
}

.opt-card .desc {
  font-size: clamp(28px, 3.6cqh, 36px);
  color: #3A4054;
  line-height: 1.45
}

.diff-row {
  display: grid;
  gap: clamp(6px, 1cqw, 12px);
  width: min(100%, 860px);
  grid-template-columns: repeat(3, 1fr)
}

/* Difficulty select */
#screen-difficulty {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #FFFDF8 0%, #FAF7F0 52%, #F1F7EF 100%)
}

#screen-difficulty::before {
  content: none
}

#screen-difficulty .center-wrap {
  position: relative;
  z-index: 1;
  gap: clamp(14px, 2.4cqh, 26px);
  padding: clamp(16px, 3cqh, 32px) 0
}

#screen-difficulty .title {
  font-size: clamp(58px, 7cqw, 96px);
  line-height: 1.08;
  max-width: calc(100cqw - 48px);
  color: #10182B;
  font-weight: 900;
  white-space: normal;
  text-wrap: balance;
  word-break: keep-all;
  -webkit-text-stroke: 0;
  text-shadow: 0 2px 8px rgba(255, 255, 255, .95), 0 1px 0 rgba(255, 255, 255, .86)
}

#screen-difficulty .title::before {
  content: "";
  display: block;
  width: clamp(78px, 5.8cqw, 112px);
  height: 8px;
  margin: 0 auto clamp(12px, 1.9cqh, 18px);
  border-radius: 999px;
  background: linear-gradient(90deg, #4F8B3C 0%, #1E5BBF 50%, #B85D57 100%)
}

#screen-difficulty .subtitle {
  font-size: clamp(34px, 4.4cqh, 46px);
  color: #24304A;
  font-weight: 900;
  margin-top: calc(clamp(4px, .8cqh, 8px) * -1);
  max-width: calc(100cqw - 48px);
  line-height: 1.25;
  word-break: keep-all;
  -webkit-text-stroke: 0;
  text-shadow: 0 2px 7px rgba(255, 255, 255, .95), 0 1px 0 rgba(255, 255, 255, .86)
}

#screen-difficulty .diff-row {
  width: min(100%, 1480px);
  gap: clamp(18px, 2.4cqw, 30px);
  align-items: stretch;
  margin-top: clamp(6px, 1.2cqh, 14px)
}

#screen-difficulty .opt-card {
  --accent: #1E5BBF;
  --line: #9FB7DD;
  --soft: #F0F6FF;
  position: relative;
  min-height: clamp(172px, 24cqh, 230px);
  padding: clamp(26px, 3.6cqh, 38px) clamp(26px, 2.5cqw, 42px) clamp(24px, 3.3cqh, 36px) clamp(112px, 7.5cqw, 142px);
  border-radius: 24px;
  border-color: var(--line);
  background: linear-gradient(180deg, #FFFFFF 0%, var(--soft) 100%);
  box-shadow: 0 18px 38px rgba(31, 36, 51, .1);
  justify-content: center;
  overflow: hidden
}

#screen-difficulty .opt-card[data-diff="easy"] {
  --accent: #4F8B3C;
  --line: #B9D3AD;
  --soft: #F2FAEE
}

#screen-difficulty .opt-card[data-diff="normal"] {
  --accent: #1E5BBF;
  --line: #ABC0E4;
  --soft: #F1F6FF
}

#screen-difficulty .opt-card[data-diff="hard"] {
  --accent: #B85D57;
  --line: #E0B4AF;
  --soft: #FFF2F0
}

#screen-difficulty .opt-card::after {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 10px;
  background: var(--accent)
}

#screen-difficulty .opt-card::before {
  content: "1";
  position: absolute;
  left: clamp(26px, 2.8cqw, 44px);
  top: 50%;
  width: clamp(68px, 8cqh, 84px);
  height: clamp(68px, 8cqh, 84px);
  border-radius: 22px;
  background: #FFFFFF;
  color: var(--accent);
  border: 4px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: clamp(68px, 9.4cqh, 92px);
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 8px 18px rgba(31, 36, 51, .09);
  transform: translateY(-50%)
}

#screen-difficulty .opt-card[data-diff="normal"]::before {
  content: "2"
}

#screen-difficulty .opt-card[data-diff="hard"]::before {
  content: "3"
}

#screen-difficulty .opt-card .name {
  font-size: clamp(60px, 8.8cqh, 84px);
  line-height: 1.12;
  color: #0E1322
}

#screen-difficulty .opt-card .desc {
  font-size: clamp(36px, 4.8cqh, 46px);
  font-weight: 700;
  color: #3A4054;
  line-height: 1.45;
  word-break: keep-all
}

#screen-difficulty .opt-card:hover {
  background: linear-gradient(180deg, #FFFFFF 0%, var(--soft) 100%);
  border-color: var(--accent);
  box-shadow: 0 18px 36px rgba(31, 36, 51, .13);
  transform: translateY(-3px)
}

#screen-difficulty .opt-card:active {
  transform: translateY(0);
  box-shadow: 0 10px 22px rgba(31, 36, 51, .1)
}

#screen-difficulty .opt-card:focus-visible {
  outline: 4px solid rgba(30, 91, 191, .28);
  outline-offset: 4px
}

#screen-difficulty #btn-diff-back {
  margin-top: clamp(10px, 1.8cqh, 20px);
  min-width: clamp(220px, 22cqw, 300px);
  font-size: clamp(34px, 4.6cqh, 44px);
  padding: clamp(14px, 2.2cqh, 20px) clamp(26px, 3cqw, 42px);
  background: #FFFDF8;
  box-shadow: 0 6px 0 #D8CEB6
}

#screen-difficulty #btn-diff-back:hover {
  background: #FFF4DA;
  box-shadow: 0 6px 0 #C9B887
}

#screen-difficulty #btn-diff-back:active {
  transform: translateY(2px);
  box-shadow: 0 4px 0 #C9B887
}

@container stage (max-width:1100px) and (min-width:761px) {
  #screen-difficulty .diff-row {
    gap: clamp(12px, 1.8cqw, 20px)
  }

  #screen-difficulty .opt-card {
    min-height: clamp(150px, 21cqh, 190px);
    padding: clamp(22px, 3cqh, 30px) clamp(20px, 2cqw, 30px) clamp(20px, 2.8cqh, 28px) clamp(92px, 9.5cqw, 112px)
  }

  #screen-difficulty .opt-card::before {
    left: clamp(20px, 2.5cqw, 30px);
    width: clamp(56px, 7cqh, 70px);
    height: clamp(56px, 7cqh, 70px);
    font-size: clamp(56px, 8cqh, 72px)
  }

  #screen-difficulty .opt-card .name {
    font-size: clamp(52px, 8cqh, 68px)
  }

  #screen-difficulty .opt-card .desc {
    font-size: clamp(32px, 4.4cqh, 40px)
  }
}

.primary {
  padding: clamp(12px, 2cqh, 16px) clamp(22px, 3cqw, 34px);
  border-radius: 14px;
  background: #1E5BBF;
  color: #FFFFFF;
  font-weight: 800;
  font-size: clamp(34px, 4.2cqh, 42px);
  box-shadow: 0 4px 12px -4px rgba(30, 91, 191, .45);
  border: 2px solid #154A9E
}

.primary:hover {
  background: #154A9E
}

.primary:disabled {
  opacity: .55;
  cursor: not-allowed;
  box-shadow: none
}

.ghost {
  padding: 14px 22px;
  border-radius: 12px;
  background: #FFFFFF;
  color: #1F2433;
  font-size: 36px;
  font-weight: 800;
  border: 2px solid #C8BFA6
}

.ghost:hover {
  background: #FFF4DA
}

/* START — main actions */
.start-actions {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: clamp(10px, 1.8cqw, 20px);
  align-items: center;
  width: min(100%, 860px);
  margin-top: clamp(6px, 1.4cqh, 14px)
}

.start-actions .side {
  display: flex;
  justify-content: center
}

.start-actions .side.left {
  justify-content: flex-end
}

.start-actions .side.right {
  justify-content: flex-start
}

.btn-big {
  padding: clamp(16px, 2.6cqh, 22px) clamp(28px, 4cqw, 52px);
  border-radius: 18px;
  background: linear-gradient(135deg, #1E5BBF, #3D86E8);
  color: #FFFFFF;
  font-weight: 900;
  font-size: clamp(40px, 6cqh, 56px);
  box-shadow: 0 8px 22px -8px rgba(30, 91, 191, .55);
  border: 3px solid #154A9E;
  min-width: clamp(180px, 30cqw, 280px);
  letter-spacing: 0
}

.btn-big:hover {
  filter: brightness(1.05)
}

.btn-big:disabled {
  opacity: .55;
  cursor: not-allowed;
  filter: grayscale(.3)
}

.btn-secondary {
  padding: clamp(13px, 2.1cqh, 18px) clamp(20px, 2.6cqw, 28px);
  border-radius: 14px;
  background: #FFFFFF;
  color: #1F2433;
  font-weight: 800;
  font-size: clamp(34px, 4.6cqh, 42px);
  border: 2px solid #C8BFA6;
  min-width: clamp(130px, 18cqw, 180px)
}

.btn-secondary:hover {
  background: #FFF4DA;
  border-color: #B48A2E
}

.start-settings-button {
  display: none;
}

@container stage (orientation:portrait) and (max-width:760px) {
  .start-actions {
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 0 16px;
    width: 100%;
    box-sizing: border-box;
  }

  .start-actions .side {
    justify-content: stretch
  }

  .start-actions .side>button {
    width: 100%;
    min-width: 0
  }

  /* 게임 시작하기: 상단 전체 폭 */
  .start-actions .side:nth-child(2) {
    grid-column: 1 / -1;
    order: 1
  }

  /* 설정 / 게임 방법: 아래 나란히 */
  .start-actions .side.left {
    order: 2;
    justify-content: stretch
  }

  .start-actions .side.right {
    order: 3;
    justify-content: stretch
  }

  .btn-big {
    width: 100%;
    font-size: clamp(44px, 11cqw, 60px);
    padding: 18px 16px
  }

  .btn-secondary {
    font-size: clamp(30px, 7.6cqw, 36px);
    padding: 14px 10px;
    min-width: 0
  }
}

/* Settings modal */
.settings-box {
  max-width: 520px;
  text-align: left;
  gap: 14px
}

.settings-box h3 {
  font-size: 60px;
  text-align: center
}

/* Help tutorial modal */
.help-box {
  max-width: 620px;
  text-align: left;
  gap: 16px
}

.help-box h3 {
  font-size: 60px;
  text-align: center
}

.help-body {
  background: #FAF7F0;
  border: 1px solid #E2D9C0;
  border-radius: 14px;
  padding: 18px 20px;
  min-height: 160px;
  display: flex;
  flex-direction: column;
  gap: 10px
}

.help-body .htitle {
  font-size: 48px;
  font-weight: 900;
  color: #13182A
}

.help-body .htext {
  font-size: 40px;
  color: #1F2433;
  line-height: 1.65;
  white-space: pre-line;
  margin: 0
}

.help-progress {
  display: flex;
  justify-content: center;
  gap: 6px
}

.help-progress .dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #D9CFB3
}

.help-progress .dot.on {
  background: #1E5BBF
}

.help-nav {
  display: flex;
  gap: 10px;
  justify-content: space-between
}

.help-nav button {
  flex: 1;
  padding: 15px;
  border-radius: 12px;
  font-weight: 800;
  font-size: 36px;
  border: 2px solid #C8BFA6;
  background: #FFFFFF;
  color: #1F2433;
  min-height: 58px
}

.help-nav button.primary-nav {
  background: #1E5BBF;
  color: #FFFFFF;
  border-color: #154A9E
}

.help-nav button:disabled {
  opacity: .4;
  cursor: not-allowed
}

/* PLAY — stacked top/middle/bottom */
.play {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-rows: auto auto minmax(0, clamp(36px, 5cqh, 54px)) minmax(0, 1fr);
  gap: clamp(5px, .9cqh, 9px);
  width: 100%
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  flex-wrap: wrap
}

.topbar .pills {
  display: flex;
  gap: 4px;
  flex-wrap: wrap
}

.topbar .pill {
  padding: 6px 13px;
  font-size: clamp(30px, 3.8cqh, 36px)
}

.topbar .actions {
  display: flex;
  gap: 6px;
  align-items: center
}

.timer {
  font-size: clamp(34px, 4.2cqh, 40px);
  color: #6B4A05;
  font-weight: 900;
  padding: 7px 15px;
  background: #FFF4DA;
  border-radius: 999px;
  border: 1px solid #E8C977;
  white-space: nowrap
}

.icon-btn {
  padding: 8px 15px;
  border-radius: 999px;
  background: #FFFFFF;
  border: 2px solid #C8BFA6;
  font-weight: 800;
  font-size: clamp(32px, 4cqh, 38px);
  color: #1F2433
}

.icon-btn:hover {
  background: #FFF4DA
}

.hint-btn {
  background: #FFF4DA;
  border-color: #E8C977;
  color: #6B4A05;
  font-weight: 900
}

.hint-btn:hover {
  background: #FFE8A8
}

.hint-btn:disabled {
  opacity: .5;
  cursor: not-allowed
}

.icon-btn.danger {
  color: #B3261E;
  border-color: #B3261E
}

.icon-btn.danger:hover {
  background: #FBE3E1
}

.qcard {
  background: #FFFFFF;
  border: 1px solid #E2D9C0;
  border-radius: 16px;
  padding: clamp(14px, 2cqh, 22px) clamp(18px, 2.4cqw, 28px);
  text-align: left
}

.qcard .sit {
  font-size: clamp(46px, 6.2cqh, 70px);
  font-weight: 900;
  color: #0E1322;
  line-height: 1.32;
  letter-spacing: 0;
  word-break: keep-all;
  margin: 0;
  max-width: 1180px;
  text-align: left
}

.qcard .sit .count-highlight {
  color: #B3261E
}

.qcard .target {
  display: inline-block;
  margin-top: 8px;
  padding: 7px 18px;
  border-radius: 999px;
  background: #E6EEFB;
  border: 1px solid #1E5BBF;
  color: #0E1322;
  font-size: clamp(32px, 3.8cqh, 40px);
  font-weight: 900;
  text-align: left
}

/* Seen items row for guess mode — large, fills available middle space */
.seen-row {
  display: flex;
  flex-wrap: wrap;
  gap: clamp(10px, 1.6cqw, 18px);
  justify-content: center;
  align-items: center;
  align-content: center;
  padding: clamp(8px, 1.2cqh, 14px) 4px;
  flex: 1;
  min-height: 0
}

.seen-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  background: #FFF4DA;
  border: 3px solid #E8C977;
  border-radius: 18px;
  padding: clamp(8px, 1.2cqh, 14px);
  flex: 0 1 auto;
  box-shadow: 0 2px 6px rgba(0, 0, 0, .06)
}

.seen-item .ph {
  width: clamp(90px, 18cqh, 180px);
  height: clamp(90px, 18cqh, 180px);
  border-radius: 14px;
  background: #FFFFFF;
  border: 1px solid #E8C977;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: clamp(44px, 6.8cqh, 60px);
  line-height: 1;
  overflow: hidden;
  padding: 8px
}

.seen-item .ph img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  user-select: none;
  pointer-events: none;
  -webkit-user-drag: none
}

.seen-item .n {
  font-size: clamp(36px, 4.8cqh, 48px);
  font-weight: 900;
  color: #13182A;
  text-align: center
}

/* Feedback area — compact, fixed position right under problem */
.fb-area {
  position: relative;
  z-index: 20;
  min-height: clamp(44px, 5.8cqh, 58px);
  max-height: clamp(54px, 7.4cqh, 68px);
  display: flex;
  align-items: center;
  justify-content: center
}

.fb-msg {
  position: relative;
  z-index: 21;
  margin: 0;
  padding: 8px 16px;
  border-radius: 10px;
  font-size: clamp(32px, 4cqh, 38px);
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
  max-width: 100%;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden
}

.fb-msg.hint {
  background: #FFF4DA;
  color: #6B4A05;
  border: 1px solid #E8C977
}

.fb-msg.ok {
  background: #E3F3E9;
  color: #13532F;
  border: 1px solid #1F7A4D
}

.fb-msg.no {
  background: #FBE3E1;
  color: #7A1612;
  border: 1px solid #B3261E
}

.fb-msg:empty {
  display: none
}

/* Card choice area — responsive grid that auto-shrinks */
.choices-wrap {
  position: relative;
  z-index: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 8px
}

.choices {
  flex: 1;
  min-height: 0;
  display: grid;
  gap: clamp(8px, 1.1cqw, 14px);
  align-content: stretch;
  justify-content: stretch;
  overflow: hidden
}

.choices.n2 {
  grid-template-columns: repeat(2, 1fr)
}

.choices.n3 {
  grid-template-columns: repeat(3, 1fr)
}

.choices.n4 {
  grid-template-columns: repeat(4, 1fr)
}

.choices.n5,
.choices.n6 {
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(2, 1fr)
}

.choices.n7,
.choices.n8 {
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(2, 1fr)
}

.choices.sit-n2 {
  grid-template-columns: repeat(2, 1fr)
}

.choices.sit-n3 {
  grid-template-columns: repeat(3, 1fr)
}

.choices.sit-n4 {
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(2, 1fr)
}

.choices.sit-n5 {
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(2, 1fr)
}

.choice {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: clamp(6px, 1cqh, 10px);
  padding: clamp(10px, 1.5cqh, 16px);
  border-radius: 16px;
  background: #FFFFFF;
  border: 4px solid #C8BFA6;
  transition: .12s;
  color: #1F2433;
  min-width: 0;
  min-height: 0;
  overflow: hidden
}

.choice .ph {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  border-radius: 12px;
  background: #FFFFFF;
  border: 1px solid #E2D9C0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3D3527;
  font-size: clamp(52px, 7cqh, 72px);
  line-height: 1.1;
  padding: clamp(6px, 1cqh, 10px);
  overflow: hidden;
  text-align: center;
  word-break: keep-all
}

.choice .ph img {
  width: 100%;
  height: 100%;
  max-width: none;
  max-height: none;
  object-fit: contain;
  user-select: none;
  pointer-events: none;
  -webkit-user-drag: none
}

.choice .n {
  flex-shrink: 0;
  font-size: clamp(42px, 5.4cqh, 56px);
  font-weight: 900;
  text-align: center;
  color: #13182A;
  line-height: 1.08;
  padding: 0 4px;
  word-break: keep-all
}

.choice:hover {
  background: #FFF4DA;
  border-color: #B48A2E
}

.choice:focus-visible {
  outline: 3px solid #1E5BBF;
  outline-offset: 2px
}

.choice.picked {
  background: #E3F3E9;
  border-color: #1F7A4D
}

.choice.picked::after {
  content: "✓";
  position: absolute;
  top: 4px;
  right: 8px;
  font-size: 36px;
  font-weight: 900;
  color: #1F7A4D;
  background: #FFF;
  border-radius: 50%;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1px 4px rgba(0, 0, 0, .15)
}

.choice.removed-state {
  background: #FBE3E1;
  border-color: #B3261E;
  opacity: .7
}

.choice.removed-state::after {
  content: "✗";
  position: absolute;
  top: 4px;
  right: 8px;
  font-size: 36px;
  font-weight: 900;
  color: #B3261E;
  background: #FFF;
  border-radius: 50%;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center
}

.choice.shake {
  animation: shake .35s
}

@keyframes shake {

  0%,
  100% {
    transform: translateX(0)
  }

  25% {
    transform: translateX(-6px)
  }

  75% {
    transform: translateX(6px)
  }
}

/* Situation buttons (guess mode) — text only, no photo */
.choice.sit {
  padding: 14px 12px;
  justify-content: center
}

.choice.sit .ph {
  display: none
}

.choice.sit .n {
  font-size: clamp(38px, 5.2cqh, 52px);
  line-height: 1.32
}

/* MODAL — generic + reveal */
.modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(20, 24, 35, .55);
  z-index: 10;
  padding: 20px
}

.modal.active {
  display: flex
}

.modal .box {
  background: #FFFFFF;
  border: 1px solid #D9CFB3;
  border-radius: 18px;
  padding: 24px;
  max-width: 460px;
  width: 100%;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 14px;
  color: #1F2433;
  animation: pop .35s cubic-bezier(.2, 1.4, .5, 1)
}

@keyframes pop {
  from {
    transform: scale(.6);
    opacity: 0
  }

  to {
    transform: scale(1);
    opacity: 1
  }
}

.modal .box h3 {
  font-size: 56px;
  color: #13182A
}

.modal .box p {
  margin: 0;
  color: #3A4054;
  font-size: 38px;
  line-height: 1.55
}

.modal .actions {
  display: flex;
  gap: 8px
}

.modal .actions button {
  flex: 1;
  padding: 16px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 38px;
  border: 2px solid transparent
}

.modal .actions .keep {
  background: #1E5BBF;
  color: #FFFFFF;
  border-color: #154A9E
}

.modal .actions .end {
  background: #FFFFFF;
  color: #B3261E;
  border-color: #B3261E
}

.modal .box.hint-box {
  max-width: min(920px, 94cqw);
  width: min(920px, 94cqw);
  max-height: min(86cqh, 760px);
  text-align: left;
  gap: clamp(16px, 2.4cqh, 24px);
  padding: clamp(26px, 3.4cqh, 36px)
}

.hint-box h3 {
  text-align: center;
  font-size: clamp(60px, 7.2cqh, 76px)
}

.hint-list {
  display: flex;
  flex-direction: column;
  gap: clamp(12px, 1.8cqh, 18px);
  max-height: min(56cqh, 500px);
  overflow: auto
}

.hint-line {
  background: #FAF7F0;
  border: 2px solid #E2D9C0;
  border-radius: 12px;
  padding: clamp(16px, 2.2cqh, 22px) clamp(18px, 2.6cqw, 28px);
  color: #1F2433;
  font-size: clamp(42px, 5.2cqh, 54px);
  line-height: 1.45;
  font-weight: 800;
  word-break: keep-all
}

.hint-line .name {
  display: block;
  color: #13182A;
  font-weight: 900;
  margin-bottom: 2px
}

#hint-modal .actions {
  margin-top: 4px
}

/* Senior-friendly pause menu */
.modal .box.pause-box {
  max-width: 520px;
  text-align: left;
  gap: 18px
}

.modal .box.pause-box h3 {
  font-size: 64px;
  text-align: center
}

.modal .box.pause-box .sub {
  text-align: center;
  color: #3A4054;
  font-size: 38px;
  margin: -6px 0 0
}

.pause-section {
  display: flex;
  flex-direction: column;
  gap: 10px
}

.pause-section .label {
  font-size: 36px;
  font-weight: 900;
  color: #13182A;
  padding: 0 4px
}

.pause-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 17px 18px;
  border-radius: 14px;
  font-size: 42px;
  font-weight: 900;
  border: 2px solid #C8BFA6;
  background: #FFFFFF;
  color: #1F2433;
  min-height: 62px;
  width: 100%
}

.pause-btn:hover {
  background: #FFF4DA
}

.pause-btn.resume,
.pause-btn.restart,
.pause-btn.help,
.pause-btn.exit {
  background: #FFFFFF;
  color: #1F2433;
  border-color: #C8BFA6
}

.pause-btn.resume:hover,
.pause-btn.restart:hover,
.pause-btn.help:hover,
.pause-btn.exit:hover {
  background: #FFF4DA
}

.sound-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  border-radius: 12px;
  background: #FAF7F0;
  border: 1px solid #E2D9C0;
  gap: 10px
}

.sound-row .nm {
  font-size: 38px;
  font-weight: 800;
  color: #13182A
}

.toggle {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 16px;
  border-radius: 999px;
  font-weight: 900;
  font-size: 36px;
  border: 2px solid #C8BFA6;
  background: #FFFFFF;
  color: #4A5060;
  min-width: 106px;
  justify-content: center
}

.toggle.on {
  background: #E3F3E9;
  color: #13532F;
  border-color: #1F7A4D
}

.toggle:disabled {
  opacity: .55;
  cursor: not-allowed
}

.toggle .dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #B0A992;
  display: inline-block
}

.toggle.on .dot {
  background: #1F7A4D
}

/* Countdown */
.countdown-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px
}

.countdown-circle {
  width: 184px;
  height: 184px;
  border-radius: 50%;
  background: linear-gradient(135deg, #1E5BBF, #3D86E8);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 148px;
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 8px 24px -8px rgba(30, 91, 191, .5);
  animation: pulse .9s ease-out
}

@keyframes pulse {
  0% {
    transform: scale(.6);
    opacity: .5
  }

  100% {
    transform: scale(1);
    opacity: 1
  }
}

/* Loading */
#loading-screen {
  position: fixed;
  inset: 0;
  background: #FAF7F0;
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: clamp(12px, 2.6cqh, 16px);
  z-index: 20;
  padding: clamp(24px, 6cqh, 64px) clamp(6px, 1.6cqw, 18px);
  text-align: center;
  overflow: hidden
}

#loading-screen.active {
  display: flex
}

#loading-screen .title-logo.sm {
  width: min(100%, 866px);
  height: clamp(170px, 26cqh, 230px);
  object-fit: cover;
  object-position: center 35%;
  margin: 0 auto calc(clamp(10px, 2.4cqh, 14px) * -1)
}

.loading-title {
  font-size: clamp(32px, 7.2cqh, 42px);
  font-weight: 900;
  color: #13182A;
  line-height: 1.16
}

.loading-sub {
  font-size: clamp(22px, 5cqh, 30px);
  color: #3A4054;
  line-height: 1.25
}

.loading-percent {
  font-size: clamp(30px, 6.8cqh, 40px);
  font-weight: 900;
  color: #1E5BBF;
  line-height: 1
}

.loading-bar {
  width: min(190px, 52cqw);
  height: 8px;
  border-radius: 999px;
  background: #EEE6D2;
  overflow: hidden;
  border: 1px solid #D9CFB3
}

.loading-bar>div {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, #1E5BBF, #3D86E8);
  transition: width .25s ease
}

/* Error */
.error-box {
  text-align: center
}

.error-box .icon {
  font-size: 84px
}

/* Cognitive area badges */
.area-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  justify-content: center;
  margin-top: 2px
}

.area-badge {
  padding: 6px 14px;
  border-radius: 999px;
  background: #E6EEFB;
  border: 1px solid #1E5BBF;
  color: #154A9E;
  font-size: 32px;
  font-weight: 900
}

.topbar .area-badges {
  margin: 0
}

.topbar .area-badge {
  padding: 5px 11px;
  font-size: 30px
}

/* Reveal modal — emphasize answer items */
#reveal-modal .box {
  max-width: min(760px, calc(100cqw - 40px));
  padding: clamp(28px, 4cqh, 42px);
  gap: clamp(18px, 3cqh, 28px)
}

#reveal-modal .box h3 {
  font-size: clamp(44px, 6cqh, 62px);
  line-height: 1.15;
  white-space: nowrap
}

#reveal-content {
  display: flex;
  justify-content: center
}

#reveal-explain {
  margin: 0;
  color: #3A4054;
  font-size: 30px;
  line-height: 1.45
}

#reveal-explain:empty {
  display: none
}

#reveal-modal .answer-items {
  display: flex;
  flex-wrap: wrap;
  gap: clamp(16px, 2.6cqh, 24px);
  justify-content: center;
  margin-top: 0
}

#reveal-modal .answer-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  background: #FFF4DA;
  border: 2px solid #E8C977;
  border-radius: 12px;
  padding: 14px 16px;
  min-width: 180px
}

#reveal-modal .answer-item .ph {
  width: 150px;
  height: 130px;
  border-radius: 10px;
  background: #FFFFFF;
  border: 1px solid #E8C977;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54px;
  line-height: 1;
  overflow: hidden;
  padding: 8px
}

#reveal-modal .answer-item .ph img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  user-select: none;
  pointer-events: none;
  -webkit-user-drag: none
}

#reveal-modal .answer-item .n {
  font-size: 44px;
  font-weight: 900;
  color: #13182A;
  line-height: 1.12
}

#reveal-modal .sit-answer {
  background: #E6EEFB;
  border: 2px solid #1E5BBF;
  border-radius: 12px;
  padding: 16px 20px;
  font-size: 48px;
  font-weight: 900;
  color: #13182A
}

@container stage (orientation:portrait) and (max-width:760px) {
  #reveal-modal {
    padding: 12px
  }

  #reveal-modal .box {
    max-width: calc(100cqw - 24px);
    padding: 22px 12px
  }

  #reveal-modal .box h3 {
    font-size: 26px
  }

  #reveal-modal .answer-item {
    min-width: 148px;
    padding: 12px
  }

  #reveal-modal .answer-item .ph {
    width: 124px;
    height: 112px
  }

  #reveal-modal .answer-item .n {
    font-size: 34px
  }
}

:root {
  --cream: #fffdf3;
  --brown-dark: #5f351a;
  --sage-dark: #4f8130;
  --ink-muted: #5f4630;
  --text-stroke: .55px;
  --soft-line: #d8bd82;
  --panel-shadow: 0 12px 26px rgba(82, 58, 33, .13), inset 0 1px 0 rgba(255, 255, 255, .95);
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-right: env(safe-area-inset-right, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-left: env(safe-area-inset-left, 0px);
}

.is-hidden {
  display: none !important;
}

.modal-layer {
  position: absolute;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(22px + var(--safe-top)) calc(28px + var(--safe-right)) calc(22px + var(--safe-bottom)) calc(28px + var(--safe-left));
  background: transparent;
}

.modal-card {
  width: min(100%, 1040px);
  max-height: calc(100cqh - 48px);
  overflow: hidden;
  border: 4px solid var(--soft-line);
  border-radius: 24px;
  background: #fff;
  color: var(--brown-dark);
  box-shadow: var(--panel-shadow);
  text-align: center;
}

.modal-card h2,
.modal-card h3,
.modal-card p {
  margin: 0;
  letter-spacing: 0;
  word-break: keep-all;
}

.game-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 64px;
  padding: 0 34px;
  border: 4px solid #d5b16c;
  border-radius: 22px;
  background: linear-gradient(180deg, #fff 0%, #fffaf0 48%, #f7ead4 100%);
  color: var(--brown-dark);
  font-weight: 900;
  line-height: 1.08;
  text-align: center;
  box-shadow: 0 4px 0 #c9a76d, 0 9px 18px rgba(88, 56, 25, .12), inset 0 1px 0 rgba(255, 255, 255, .95);
  -webkit-text-stroke: var(--text-stroke) currentColor;
  transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
}

.game-button:hover {
  background: linear-gradient(180deg, #fff 0%, #fff6e1 100%);
}

.game-button:active {
  transform: translateY(3px);
  box-shadow: 0 1px 0 #c9a76d, 0 5px 12px rgba(88, 56, 25, .11), inset 0 1px 0 rgba(255, 255, 255, .95);
}

.game-button:focus-visible,
.condition-mood-button:focus-visible,
.post-condition-option:focus-visible,
.pause-sound-button:focus-visible,
.setting-toggle:focus-visible {
  outline: 5px solid rgba(68, 126, 42, .28);
  outline-offset: 4px;
}

.primary-button,
.condition-confirm-button {
  border-color: #eaa0bc;
  background: linear-gradient(180deg, #fff 0%, #fff6fb 42%, #fde8f1 100%);
  color: #7b314e;
  box-shadow: 0 4px 0 #d982a4, 0 9px 18px rgba(123, 49, 78, .14), inset 0 1px 0 rgba(255, 255, 255, .95);
}

.secondary-button,
.condition-skip-button {
  border-color: #d4b47a;
  background: linear-gradient(180deg, #fff 0%, #fffaf1 45%, #f5ead7 100%);
  color: var(--brown-dark);
}

#screen-difficulty.difficulty-screen {
  align-items: center;
  justify-content: center;
  padding: calc(28px + var(--safe-top)) calc(36px + var(--safe-right)) calc(28px + var(--safe-bottom)) calc(36px + var(--safe-left));
  overflow: hidden;
  background: transparent;
}

.difficulty-content {
  width: min(100%, 1040px);
  max-height: calc(100cqh - 72px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18px;
  padding: 34px 38px 28px;
  border: 4px solid var(--soft-line);
  border-radius: 24px;
  background: #fff;
  box-shadow: var(--panel-shadow);
  text-align: center;
  overflow: hidden;
}

.difficulty-content .eyebrow {
  margin: 0;
  color: #705736;
  font-size: 28px;
  font-weight: 900;
}

.difficulty-content h2 {
  margin: 0;
  color: #293b1d;
  font-size: 56px;
  font-weight: 1000;
  line-height: 1.08;
  -webkit-text-stroke: var(--text-stroke) currentColor;
}

.difficulty-options {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.difficulty-option {
  min-height: 220px;
  padding: 22px 18px;
  flex-direction: column;
  gap: 10px;
  border-color: #d5b16c;
  border-radius: 22px;
}

.difficulty-option-icon {
  display: grid;
  place-items: center;
  width: 86px;
  height: 86px;
  border: 3px solid #ead2a5;
  border-radius: 24px;
  background: #fff7df;
  font-size: 48px;
  line-height: 1;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .95);
}

.difficulty-option strong {
  color: #2d421f;
  font-size: 42px;
  font-weight: 1000;
  line-height: 1;
}

.difficulty-option span:last-child {
  color: #6b5434;
  font-size: 25px;
  font-weight: 900;
  line-height: 1.16;
  -webkit-text-stroke: 0;
}

.difficulty-back-button {
  min-width: 280px;
  min-height: 64px;
  font-size: 36px;
}

.condition-card {
  width: min(100%, 1080px);
  padding: 26px 38px 30px;
}

.condition-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  color: #293b1d;
  font-size: 58px;
  font-weight: 1000;
  line-height: 1.05;
  -webkit-text-stroke: var(--text-stroke) currentColor;
}

.condition-title-icon {
  display: grid;
  place-items: center;
  width: 70px;
  height: 70px;
  border: 3px solid #ead2a5;
  border-radius: 20px;
  background: #fff8e4;
  font-size: 42px;
  line-height: 1;
}

.condition-title-text {
  min-width: 0;
}

.condition-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-top: 24px;
}

.condition-panel {
  min-height: 252px;
  padding: 18px 20px 22px;
  border: 3px solid #d7bb82;
  border-radius: 18px;
  background: #fffdf8;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .95);
}

.condition-section-title {
  color: #293b1d;
