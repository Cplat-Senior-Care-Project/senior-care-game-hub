/* Final non-topbar image-button sizing override. */
:root {
  --image-btn-action-width: clamp(240px, 22cqw, 280px);
  --image-btn-action-height: clamp(70px, 8.4cqh, 86px);
  --image-btn-option-height: clamp(106px, 13cqh, 126px);
  --image-btn-small-height: clamp(58px, 7cqh, 70px);
}

.start-actions {
  width: min(100%, 960px);
  grid-template-columns: repeat(3, 1fr);
  justify-items: center;
}

.start-actions .side,
.start-actions .side.left,
.start-actions .side.right {
  justify-content: center;
  width: 100%;
}

#screen-start {
  background: transparent;
}

#screen-condition,
#screen-difficulty,
#loading-screen {
  background: transparent;
}

#screen-play {
  background: transparent;
}

#screen-condition {
  position: relative;
}

#screen-start::before,
#screen-play::before {
  content: none !important;
  display: none !important;
}

#screen-start::before {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, .16) 0%, rgba(255, 255, 255, .04) 45%, rgba(230, 241, 234, .12) 100%);
  opacity: 1;
}

#screen-condition::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(255, 255, 255, .42) 0%, rgba(255, 255, 255, .12) 48%, rgba(230, 241, 234, .24) 100%);
}

#loading-screen {
  position: fixed;
}

#loading-screen::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(255, 255, 255, .5) 0%, rgba(255, 255, 255, .22) 48%, rgba(250, 247, 240, .5) 100%);
}

#loading-screen>* {
  position: relative;
  z-index: 1;
}

#loading-screen .loading-title,
#loading-screen .loading-sub,
#loading-screen .loading-percent,
#loading-screen .loading-bar {
  filter: drop-shadow(0 2px 3px rgba(255, 255, 255, .85));
}

.btn-big,
.btn-secondary,
.primary,
.ghost,
.result-box .btn-return,
.post-actions .btn-return,
.help-nav button,
.modal .actions button,
#screen-condition .cc-skip,
#screen-condition .cc-confirm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 var(--image-btn-action-width);
  inline-size: min(100%, var(--image-btn-action-width));
  min-inline-size: 0;
  max-inline-size: var(--image-btn-action-width);
  block-size: var(--image-btn-action-height);
  min-block-size: var(--image-btn-action-height);
  padding: 0 clamp(16px, 2cqw, 24px);
  border-radius: 0;
  font-size: clamp(34px, 4.8cqh, 46px);
  font-weight: 900;
  line-height: 1.05;
  text-align: center;
  white-space: nowrap;
}

.result-box .btns,
.post-actions,
.help-nav,
.modal .actions,
#screen-condition .cc-confirm-bar {
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
}

#screen-condition .cc-confirm {
  width: min(100%, var(--image-btn-action-width));
  max-width: var(--image-btn-action-width);
}

