{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Banditburi: start local hub",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\start-local-hub.ps1",
        "8080"
      ],
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "banditburi-local-hub",
          "pattern": [
            {
              "regexp": "^$"
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Local hub:",
            "endsPattern": "Save files in VS Code"
          }
        }
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
